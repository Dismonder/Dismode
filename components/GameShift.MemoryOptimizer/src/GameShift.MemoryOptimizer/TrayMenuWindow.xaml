<Window
    x:Class="GameShift.MemoryOptimizer.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameShift Memory Optimizer">
  <Grid x:Name="MenuRoot" RequestedTheme="Dark"
        Background="{ThemeResource MemoryTrayPanelBrush}" UseLayoutRounding="True"
        KeyDown="MenuRoot_KeyDown">
    <Grid.Resources>
      <Style x:Key="TrayActionStyle" TargetType="Button" BasedOn="{StaticResource MemorySecondaryButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
      </Style>
      <Style x:Key="TrayQuietActionStyle" TargetType="Button" BasedOn="{StaticResource TrayActionStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Grid.Resources>
    <Border Padding="20" BorderBrush="{ThemeResource MemoryBorderBrush}" BorderThickness="1" CornerRadius="12">
      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="130" />
          <RowDefinition Height="*" />
          <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <Border Height="36" Background="{ThemeResource MemoryAccentSoftBrush}" CornerRadius="10">
            <FontIcon FontSize="19" Foreground="{ThemeResource MemoryAccentBrush}" Glyph="&#xE950;" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Memory Optimizer" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="GAMESHIFT" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource MemoryMutedBrush}" />
          </StackPanel>
          <Button x:Name="CloseMenuButton" Grid.Column="2" Width="32" Height="32" MinHeight="32"
                  Padding="0" Click="CloseMenuButton_Click" Content="&#xE711;"
                  FontFamily="Segoe MDL2 Assets" FontSize="12" Style="{StaticResource TrayQuietActionStyle}"
                  AutomationProperties.Name="Zamknij menu" ToolTipService.ToolTip="Zamknij menu (Esc)" />
        </Grid>

        <Border Grid.Row="1" Padding="14" Background="{ThemeResource MemoryInsetBrush}" CornerRadius="10">
          <Grid RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="6" />
              <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="MemoryPercentText" Text="—" FontSize="38" FontWeight="SemiBold" Foreground="{ThemeResource MemoryAccentBrush}" />
                <TextBlock Text="RAM" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,9" Foreground="{ThemeResource MemoryMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="AvailableMemoryText" Text="—" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="dostępnej pamięci" FontSize="12" Foreground="{ThemeResource MemoryMutedBrush}" />
              </StackPanel>
            </Grid>
            <ProgressBar x:Name="RamProgressBar" Grid.Row="1" Height="6" Minimum="0" Maximum="100"
                         Foreground="{ThemeResource MemoryAccentBrush}" Background="{ThemeResource MemoryTrackBrush}"
                         IsHitTestVisible="False" AutomationProperties.Name="Użycie RAM" />
            <Grid Grid.Row="2" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="MemoryUsageText" Text="Oczekiwanie na pomiar" FontSize="12"
                         TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MemoryMutedBrush}" />
              <TextBlock x:Name="MemoryPressureText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MemorySecondaryTextBrush}" />
            </Grid>
          </Grid>
        </Border>

        <Grid x:Name="ActionArea" Grid.Row="2">
          <StackPanel x:Name="ActionButtonsPanel" Spacing="8">
            <Button x:Name="OptimizeMenuButton" Height="44" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Padding="14,8" Click="OptimizeMenuButton_Click"
                    Style="{StaticResource MemoryPrimaryButtonStyle}">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE945;" FontSize="17" />
                <TextBlock x:Name="OptimizeMenuTitle" Grid.Column="1" Text="Optymalizuj zapisany profil"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressRing x:Name="OptimizeProgress" Grid.Column="2" Width="18" Height="18"
                              IsActive="False" Opacity="0" Foreground="{ThemeResource MemoryAccentForegroundBrush}" />
              </Grid>
            </Button>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="PauseMenuButton" Height="44" Click="PauseMenuButton_Click" Style="{StaticResource TrayActionStyle}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon x:Name="PauseMenuIcon" Glyph="&#xE769;" FontSize="14" />
                  <TextBlock x:Name="PauseMenuTitle" Grid.Column="1" Text="Wstrzymaj" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button x:Name="OpenMenuButton" Grid.Column="1" Height="44" Click="OpenMenuButton_Click" Style="{StaticResource TrayActionStyle}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE713;" FontSize="14" />
                  <TextBlock Grid.Column="1" Text="Otwórz panel" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Grid>
            <Grid Height="48" ColumnSpacing="8" Padding="4,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="ServiceStatusDot" Width="6" Height="6" VerticalAlignment="Top" Margin="0,7,0,0" Fill="{ThemeResource MemoryMutedBrush}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="MemoryStatusText" Text="Łączenie z usługą…" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="ServiceDetailText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MemoryMutedBrush}" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource MemoryDividerBrush}" />
            <Button x:Name="ExitMenuButton" Click="ExitMenuButton_Click" Style="{StaticResource TrayQuietActionStyle}"
                    ToolTipService.ToolTip="Zamknij okno i ikonę w trayu. Usługa nadal pracuje w tle.">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                <TextBlock Grid.Column="1" Text="Zamknij interfejs — zostaw usługę" FontSize="13" />
              </Grid>
            </Button>
            <Button x:Name="DisableMenuButton" Click="DisableMenuButton_Click" Style="{StaticResource TrayQuietActionStyle}"
                    Foreground="{ThemeResource MemoryDangerBrush}">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7E8;" FontSize="15" />
                <TextBlock Grid.Column="1" Text="Wyłącz Memory Optimizer" FontSize="13" />
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" />
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel x:Name="DisablePromptPanel" Spacing="14" Visibility="Collapsed">
            <Border Padding="14" Background="{ThemeResource MemoryWarningSoftBrush}" CornerRadius="10">
              <StackPanel Spacing="8">
                <TextBlock Text="Wyłączyć cały moduł?" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Zatrzymamy usługę i wyłączymy start z Windows. Optymalizacja w tle przestanie działać. Dane i historia pozostaną na dysku."
                           FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="CancelDisableButton" Click="CancelDisableButton_Click" Content="Wróć"
                      Style="{StaticResource TrayActionStyle}" HorizontalContentAlignment="Center" />
              <Button x:Name="ConfirmDisableButton" Grid.Column="1" Click="ConfirmDisableButton_Click" Content="Wyłącz moduł"
                      Style="{StaticResource TrayActionStyle}" HorizontalContentAlignment="Center" Foreground="{ThemeResource MemoryDangerBrush}" />
            </Grid>
            <TextBlock x:Name="DisableStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MemoryMutedBrush}" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" Text="Usługa działa niezależnie od interfejsu." FontSize="12"
                   VerticalAlignment="Bottom" Foreground="{ThemeResource MemoryMutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
