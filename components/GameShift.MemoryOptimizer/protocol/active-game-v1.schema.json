{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameshift.local/schemas/active-game-v1.json",
  "title": "GameShift active game lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "displayName",
    "processId",
    "startedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
    "processId": { "type": "integer", "minimum": 1 },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
