<Application
    x:Class="Dismode.MemoryOptimizer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <LinearGradientBrush x:Key="MemoryBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MemoryTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="MemoryNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="MemoryCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="MemoryTrayPanelBrush" Color="#FF151A1E" />
          <SolidColorBrush x:Key="MemoryElevatedBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="MemoryInsetBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="MemoryBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="MemoryDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="MemoryMutedBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="MemorySecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="MemoryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="MemoryAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="MemoryAccentForegroundBrush" Color="#FF041112" />
          <SolidColorBrush x:Key="MemoryAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="MemorySuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="MemoryWarningBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="MemoryWarningSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="MemoryDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="MemoryTrackBrush" Color="#3345555D" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#00D7E2" />
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F50C1217" />
            <GradientStop Offset="0.52" Color="#F20D141A" />
            <GradientStop Offset="1" Color="#4A1FB9C2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#B300D7E2" />
            <GradientStop Offset="0.22" Color="#FF2A3339" />
            <GradientStop Offset="1" Color="#FF1C2126" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF323C43" />
            <GradientStop Offset="0.4" Color="#FF24292E" />
            <GradientStop Offset="1" Color="#FF1D2227" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="MemoryBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MemoryTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="MemoryNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="MemoryCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="MemoryTrayPanelBrush" Color="#FF151A1E" />
          <SolidColorBrush x:Key="MemoryElevatedBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="MemoryInsetBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="MemoryBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="MemoryDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="MemoryMutedBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="MemorySecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="MemoryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="MemoryAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="MemoryAccentForegroundBrush" Color="#FF041112" />
          <SolidColorBrush x:Key="MemoryAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="MemorySuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="MemoryWarningBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="MemoryWarningSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="MemoryDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="MemoryTrackBrush" Color="#3345555D" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#00D7E2" />
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F50C1217" />
            <GradientStop Offset="0.52" Color="#F20D141A" />
            <GradientStop Offset="1" Color="#4A1FB9C2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#B300D7E2" />
            <GradientStop Offset="0.22" Color="#FF2A3339" />
            <GradientStop Offset="1" Color="#FF1C2126" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF323C43" />
            <GradientStop Offset="0.4" Color="#FF24292E" />
            <GradientStop Offset="1" Color="#FF1D2227" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="MemoryBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F5F8FA" />
            <GradientStop Offset="0.58" Color="#EDF3F5" />
            <GradientStop Offset="1" Color="#E7EEF1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MemoryTitleBarBrush" Color="#F8FBFC" />
          <SolidColorBrush x:Key="MemoryNavigationBrush" Color="#F7FBFC" />
          <SolidColorBrush x:Key="MemoryCardBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="MemoryTrayPanelBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="MemoryElevatedBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="MemoryInsetBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="MemoryBorderBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="MemoryDividerBrush" Color="#26576C74" />
          <SolidColorBrush x:Key="MemoryMutedBrush" Color="#53666E" />
          <SolidColorBrush x:Key="MemorySecondaryTextBrush" Color="#C92B343A" />
          <SolidColorBrush x:Key="MemoryTextBrush" Color="#D81A2126" />
          <SolidColorBrush x:Key="MemoryAccentBrush" Color="#087E86" />
          <SolidColorBrush x:Key="MemoryAccentForegroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="MemoryAccentSoftBrush" Color="#24069AA3" />
          <SolidColorBrush x:Key="MemorySuccessBrush" Color="#08784D" />
          <SolidColorBrush x:Key="MemoryWarningBrush" Color="#9B5A00" />
          <SolidColorBrush x:Key="MemoryWarningSoftBrush" Color="#24069AA3" />
          <SolidColorBrush x:Key="MemoryDangerBrush" Color="#B72C38" />
          <SolidColorBrush x:Key="MemoryTrackBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#53666E" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#087E86" />
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="0.52" Color="#FAF7FBFC" />
            <GradientStop Offset="1" Color="#FFD4EEF1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#99087E86" />
            <GradientStop Offset="0.22" Color="#40576C74" />
            <GradientStop Offset="1" Color="#33576C74" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#26576C74" />
            <GradientStop Offset="1" Color="#40576C74" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="MemoryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryTitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryNavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryTrayPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="MemoryDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="MemoryMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
          <SolidColorBrush x:Key="MemorySecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="MemoryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="MemoryAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="MemoryAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
          <SolidColorBrush x:Key="MemoryAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemorySuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
          <SolidColorBrush x:Key="MemoryWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="MemoryWarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="MemoryDangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
          <SolidColorBrush x:Key="MemoryTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="DismodeDeckHeaderBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="DismodeDeckHeaderEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeCardEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="DismodeDeckCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="22,17" />
        <Setter Property="Background" Value="{ThemeResource DismodeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>
      <Style x:Key="DismodeDeckHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,18" />
        <Setter Property="Background" Value="{ThemeResource DismodeDeckHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeDeckHeaderEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>
      <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      </Style>
      <Style x:Key="MemoryCardStyle" TargetType="Border" BasedOn="{StaticResource DismodeDeckCardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{ThemeResource MemoryCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="MemoryListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
      </Style>
      <Style x:Key="MemoryInsetCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{ThemeResource MemoryInsetBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MemoryDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="MemoryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{ThemeResource MemoryAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MemoryAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MemoryAccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <!-- MinHeight 42 jak w stylu glownym: oba warianty stoja obok siebie
           w jednej grupie akcji i przy 40 kontra 42 dolna krawedz sie rozjezdza. -->
      <Style x:Key="MemorySecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{ThemeResource MemoryElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MemoryBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MemorySecondaryTextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="MemoryMoreButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource MemoryAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="MemoryMoreToggleStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource MemoryAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="MemoryEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MemoryAccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="105" />
      </Style>
      <Style x:Key="MemoryPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="MemorySectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="MemoryMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MemoryMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="75" />
      </Style>
      <Style x:Key="MemoryMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="MemoryMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MemoryMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
