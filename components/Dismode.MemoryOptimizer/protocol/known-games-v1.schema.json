{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dismode.local/schemas/known-games-v1.json",
  "title": "Dismode known games v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAtUtc", "games"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "games": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "executableNames"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
          "executableNames": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 260 }
          }
        }
      }
    }
  }
}
