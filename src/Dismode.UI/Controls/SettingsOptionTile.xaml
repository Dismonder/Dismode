<UserControl
    x:Class="Dismode.UI.Controls.SettingsOptionTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <Style x:Key="MoreLinkStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{ThemeResource DismodeMutedTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid x:Name="LinkRoot" Background="Transparent" MinHeight="24">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters><Setter Target="LinkContent.Foreground" Value="{ThemeResource DismodeAccentBrush}" /></VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="LinkContent.Foreground" Value="{ThemeResource DismodeAccentBrush}" />
                      <Setter Target="LinkRoot.Opacity" Value="0.65" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="LinkRoot.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter x:Name="LinkContent" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Border Style="{StaticResource DismodeDeckCardStyle}" Padding="16" />
    <Border x:Name="AccentSurface" Background="{ThemeResource DismodeAccentSoftBrush}" BorderBrush="{ThemeResource DismodeAccentBrush}" BorderThickness="1" CornerRadius="11" Opacity="0" IsHitTestVisible="False" />
    <StackPanel Margin="16" Spacing="8">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon HorizontalAlignment="Left" Foreground="{ThemeResource DismodeAccentBrush}" FontSize="20" Glyph="{x:Bind Glyph}" />
        <ContentPresenter Grid.Column="1" Content="{x:Bind Option}" />
      </Grid>
      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
      <TextBlock Foreground="{ThemeResource DismodeMutedTextBrush}" FontSize="12" Text="{x:Bind Benefit}" TextWrapping="Wrap" />
      <ToggleButton x:Name="MoreLink" Style="{StaticResource MoreLinkStyle}" HorizontalAlignment="Left" AutomationProperties.Name="Więcej" IsChecked="False" Click="OnMoreClicked">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Więcej" FontSize="12" />
          <FontIcon Glyph="&#xE70D;" FontSize="8" RenderTransformOrigin="0.5,0.5">
            <FontIcon.RenderTransform><RotateTransform x:Name="ChevronRotation" /></FontIcon.RenderTransform>
          </FontIcon>
        </StackPanel>
      </ToggleButton>
      <Grid x:Name="DetailHost" Height="0" Opacity="0" Visibility="Collapsed" SizeChanged="OnDetailSizeChanged">
        <Grid.Clip><RectangleGeometry x:Name="DetailClip" /></Grid.Clip>
        <ContentPresenter x:Name="DetailText" VerticalAlignment="Top" Content="{x:Bind Details}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
