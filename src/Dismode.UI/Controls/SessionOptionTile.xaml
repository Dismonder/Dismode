<UserControl
    x:Class="Dismode.UI.Controls.SessionOptionTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
  <UserControl.Resources>
    <Style x:Key="OptionSwitchStyle" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid x:Name="SwitchRoot" Background="Transparent" MinHeight="40" ColumnSpacing="8">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Track.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SwitchRoot.Opacity" Value="0.65" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SwitchRoot.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18" /></VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Track.Background" Value="{ThemeResource DismodeAccentBrush}" />
                      <Setter Target="KnobShift.X" Value="18" />
                      <Setter Target="Knob.Fill" Value="{ThemeResource DismodeBackgroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
              <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center" Background="{ThemeResource DismodeCardEdgeBrush}" CornerRadius="11">
                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorPrimaryBrush}">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift" /></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Border Style="{StaticResource DismodeDeckCardStyle}" Padding="16" />
    <Border x:Name="AccentSurface" Background="{ThemeResource DismodeAccentSoftBrush}" BorderBrush="{ThemeResource DismodeAccentBrush}" BorderThickness="1" CornerRadius="11" Opacity="0" IsHitTestVisible="False" />
    <StackPanel Margin="16" Spacing="8">
      <FontIcon HorizontalAlignment="Left" Foreground="{ThemeResource DismodeAccentBrush}" FontSize="20" Glyph="{x:Bind Glyph}" />
      <ContentPresenter x:Name="OptionPresenter" Content="{x:Bind Option}" />
      <TextBlock Foreground="{ThemeResource DismodeMutedTextBrush}" FontSize="12" Text="{x:Bind Benefit}" TextWrapping="Wrap" />
      <Expander Header="Więcej" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <TextBlock FontSize="12" Text="{x:Bind Detail}" TextWrapping="Wrap" />
      </Expander>
    </StackPanel>
  </Grid>
</UserControl>
