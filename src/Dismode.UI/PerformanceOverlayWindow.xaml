<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dismode.UI.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Same liczby na obrazie gry, bez tla i bez ramki.

    Cztery style wspoldziela liczby i cienie. Kod zwija niepotrzebne
    wiersze i mierzy widoczna tresc przed ustawieniem okna w rogu ekranu.

    Czytelnosc bez panelu daje cien: pod kazdym napisem lezy jego czarna
    kopia przesunieta o piksel. To samo rozwiazanie ma nakladka RivaTunera
    i Steama, i dziala zarowno na jasnej scenie, jak i na ciemnej —
    polprzezroczysty prostokat zaslania obraz zawsze, a cien tylko obrysowuje
    znaki.

    Tresc cienia ustawia kod, nie wiazanie. Pierwsza wersja uzywala tu
    {Binding Text, ElementName=...} i to wywracalo caly proces wyjatkiem
    XAML 0xc000027b juz przy starcie.

    Czcionka o stalej szerokosci jest funkcja, nie stylistyka: przy zmiennej
    liczba skacze w poziomie przy kazdej zmianie i widac to katem oka.
  -->
  <Grid x:Name="OverlayRoot" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
    </Grid.RenderTransform>

    <StackPanel
        x:Name="OverlayStatisticsContent"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Spacing="0">

      <!-- FPS. Jedyna liczba, ktora ma byc widoczna z daleka. -->
      <Grid x:Name="FpsRow">
        <TextBlock
            FontFamily="Consolas"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#D9000000"
            Margin="2,2,0,0"
            x:Name="FpsShadowText"
            Text="— FPS" />
        <TextBlock
            x:Name="FpsValueText"
            FontFamily="Consolas"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#FF5BE37D"
            Text="—" />
      </Grid>

      <!-- Czas klatki. Mniejszy, bo sluzy do zerkniecia, nie do patrzenia. -->
      <Grid x:Name="FrameTimeRow">
        <TextBlock
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D9000000"
            Margin="1,1,0,0"
            x:Name="FrameTimeShadowText"
            Text="—" />
        <TextBlock
            x:Name="FrameTimeValueText"
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#FFE6ECF0"
            Text="—" />
      </Grid>

      <!-- Najnizszy procent klatek. To on pokazuje przyciecia. -->
      <Grid x:Name="OnePercentLowRow">
        <TextBlock
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D9000000"
            Margin="1,1,0,0"
            x:Name="OnePercentLowShadowText"
            Text="—" />
        <TextBlock
            x:Name="OnePercentLowText"
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#FFBFC8CE"
            Text="—" />
      </Grid>

      <Grid x:Name="CompactBarLayout" Visibility="Collapsed">
        <TextBlock x:Name="CompactTelemetryShadowText" FontFamily="Consolas" FontSize="16"
                   FontWeight="SemiBold" Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock x:Name="CompactTelemetryText" FontFamily="Consolas" FontSize="16"
                   FontWeight="SemiBold" Foreground="#FFE6ECF0" />
      </Grid>

      <Grid x:Name="CpuTelemetryRow" Visibility="Collapsed">
        <TextBlock x:Name="CpuTelemetryShadowText" FontFamily="Consolas" FontSize="14"
                   Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock x:Name="CpuTelemetryText" FontFamily="Consolas" FontSize="14"
                   Foreground="#FFE6ECF0" />
      </Grid>
      <Grid x:Name="GpuTelemetryRow" Visibility="Collapsed">
        <TextBlock x:Name="GpuTelemetryShadowText" FontFamily="Consolas" FontSize="14"
                   Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock x:Name="GpuTelemetryText" FontFamily="Consolas" FontSize="14"
                   Foreground="#FFE6ECF0" />
      </Grid>
      <Grid x:Name="VramTelemetryRow" Visibility="Collapsed">
        <TextBlock x:Name="VramTelemetryShadowText" FontFamily="Consolas" FontSize="14"
                   Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock x:Name="VramTelemetryText" FontFamily="Consolas" FontSize="14"
                   Foreground="#FFE6ECF0" />
      </Grid>
      <Grid x:Name="VendorTelemetryRow" Visibility="Collapsed">
        <TextBlock x:Name="VendorTelemetryShadowText" FontFamily="Consolas" FontSize="14"
                   Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock x:Name="VendorTelemetryText" FontFamily="Consolas" FontSize="14"
                   Foreground="#FFE6ECF0" />
      </Grid>

      <!--
        Nazwa gry i zrodlo pomiaru. Ledwie widoczne i celowo: sa potrzebne
        tylko wtedy, gdy cos nie dziala i trzeba sprawdzic, co nakladka
        w ogole mierzy.
      -->
      <Grid x:Name="GameNameRow" Margin="0,8,0,0">
        <TextBlock x:Name="GameNameShadowText" FontFamily="Consolas" FontSize="10"
                   Foreground="#D9000000" Margin="1,1,0,0" MaxWidth="224"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock
          x:Name="GameNameText"
          FontFamily="Consolas"
          FontSize="10"
          Foreground="#8CFFFFFF"
          TextTrimming="CharacterEllipsis"
          MaxWidth="224"
          Text="—" />
      </Grid>
      <Grid x:Name="SourceStatusRow">
        <TextBlock x:Name="SourceStatusShadowText" FontFamily="Consolas" FontSize="9"
                   Foreground="#D9000000" Margin="1,1,0,0" />
        <TextBlock
          x:Name="SourceStatusText"
          FontFamily="Consolas"
          FontSize="9"
          Foreground="#73FFFFFF"
          Text="" />
      </Grid>

      <!-- Wykres tylko w pelnych szczegolach; czarna kopia daje kontrast. -->
      <Grid x:Name="FrameGraphRow" Margin="0,8,0,0" HorizontalAlignment="Left">
        <Polyline x:Name="FrameGraphShadowLine" Height="32" Width="224"
                  Stroke="#D9000000" StrokeThickness="3" Margin="1,1,0,0" />
        <Polyline
          x:Name="FrameGraphLine"
          Height="32"
          Width="224"
          Stroke="#FF5BE37D"
          StrokeThickness="1"
          HorizontalAlignment="Left" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
