<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dismode.UI.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Same liczby na obrazie gry, bez tla i bez ramki.

    Poprzednia wersja rysowala ciemny panel z kolumna etykiet, wykresem
    i linijka statusu. Wygladalo to jak tabelka polozona na grze i zaslanialo
    jej fragment, a nakladka ma byc niewidoczna dopoki nie spojrzy sie
    wprost na liczbe.

    Czytelnosc bez panelu daje cien: pod kazdym napisem lezy jego czarna
    kopia przesunieta o piksel. To samo rozwiazanie ma nakladka RivaTunera
    i Steama, i dziala zarowno na jasnej scenie, jak i na ciemnej —
    polprzezroczysty prostokat zaslania obraz zawsze, a cien tylko obrysowuje
    znaki.

    Tresc cienia ustawia kod, nie wiazanie. Pierwsza wersja uzywala tu
    {Binding Text, ElementName=...} i to wywracalo caly proces wyjatkiem
    XAML 0xc000027b juz przy starcie.

    Czcionka o stalej szerokosci jest funkcja, nie stylistyka: przy zmiennej
    liczba skacze w poziomie przy kazdej zmianie i widac to katem oka.
  -->
  <Grid x:Name="OverlayRoot" Background="Transparent">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
    </Grid.RenderTransform>

    <StackPanel
        x:Name="OverlayStatisticsContent"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Spacing="0">

      <!-- FPS. Jedyna liczba, ktora ma byc widoczna z daleka. -->
      <Grid>
        <TextBlock
            FontFamily="Consolas"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#D9000000"
            Margin="2,2,0,0"
            x:Name="FpsShadowText"
            Text="— FPS" />
        <TextBlock
            x:Name="FpsValueText"
            FontFamily="Consolas"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#FF5BE37D"
            Text="—" />
      </Grid>

      <!-- Czas klatki. Mniejszy, bo sluzy do zerkniecia, nie do patrzenia. -->
      <Grid Margin="0,-2,0,0">
        <TextBlock
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D9000000"
            Margin="1,1,0,0"
            x:Name="FrameTimeShadowText"
            Text="—" />
        <TextBlock
            x:Name="FrameTimeValueText"
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#FFE6ECF0"
            Text="—" />
      </Grid>

      <!-- Najnizszy procent klatek. To on pokazuje przyciecia. -->
      <Grid Margin="0,-1,0,0">
        <TextBlock
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D9000000"
            Margin="1,1,0,0"
            x:Name="OnePercentLowShadowText"
            Text="—" />
        <TextBlock
            x:Name="OnePercentLowText"
            FontFamily="Consolas"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#FFBFC8CE"
            Text="—" />
      </Grid>

      <!--
        Nazwa gry i zrodlo pomiaru. Ledwie widoczne i celowo: sa potrzebne
        tylko wtedy, gdy cos nie dziala i trzeba sprawdzic, co nakladka
        w ogole mierzy.
      -->
      <TextBlock
          x:Name="GameNameText"
          FontFamily="Consolas"
          FontSize="10"
          Foreground="#8CFFFFFF"
          TextTrimming="CharacterEllipsis"
          MaxWidth="220"
          Margin="0,2,0,0"
          Text="—" />
      <TextBlock
          x:Name="SourceStatusText"
          FontFamily="Consolas"
          FontSize="9"
          Foreground="#73FFFFFF"
          Text="" />

      <!--
        Wykres czasu klatki zostaje w drzewie, bo kod go wypelnia, ale jest
        zwiniety: linia na obrazie gry to juz nie "same liczby". Wroci, gdy
        przelacznik stylu nakladki zacznie cokolwiek robic — dzis pole Style
        jest zapisywane i ignorowane.
      -->
      <Polyline
          x:Name="FrameGraphLine"
          Height="26"
          Width="150"
          Stroke="#FF5BE37D"
          StrokeThickness="1"
          HorizontalAlignment="Left"
          Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>
