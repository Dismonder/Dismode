<Application
    x:Class="Dismode.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <LinearGradientBrush x:Key="DismodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodeTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="DismodeNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="DismodePanelBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="DismodeCardBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="DismodeMutedTextBrush" Color="#9DA5AA" />
          <!-- Skala tekstu i linii wydzielona z wartosci, ktore juz byly
               rozsypane po MainWindow.xaml jako literalne kolory. -->
          <SolidColorBrush x:Key="DismodePrimaryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="DismodeSecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="DismodeTertiaryTextBrush" Color="#BAC5CACD" />
          <SolidColorBrush x:Key="DismodeSubtleTextBrush" Color="#EF889097" />
          <SolidColorBrush x:Key="DismodeDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="DismodeAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="DismodePurpleBrush" Color="#45CDD8" />
          <SolidColorBrush x:Key="DismodeSuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="DismodeAmberBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="DismodeDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="DismodeTrackBrush" Color="#3345555D" />
          <LinearGradientBrush x:Key="DismodeHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4620D5DB" />
            <GradientStop Offset="0.58" Color="#25157B83" />
            <GradientStop Offset="1" Color="#301D252E" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F205080C" />
            <GradientStop Offset="0.46" Color="#9A05080C" />
            <GradientStop Offset="0.76" Color="#3005080C" />
            <GradientStop Offset="1" Color="#1005080C" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5030EFF4" />
            <GradientStop Offset="1" Color="#2820A9B3" />
          </LinearGradientBrush>
          <!-- Tactical Deck poza menu glownym: te same powierzchnie, krawedz
               lapiaca swiatlo od gory i cyjanowa poswiata po prawej, jak
               w kaflu hero. -->
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F50C1217" />
            <GradientStop Offset="0.52" Color="#F20D141A" />
            <GradientStop Offset="1" Color="#4A1FB9C2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#B300D7E2" />
            <GradientStop Offset="0.22" Color="#FF2A3339" />
            <GradientStop Offset="1" Color="#FF1C2126" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF323C43" />
            <GradientStop Offset="0.4" Color="#FF24292E" />
            <GradientStop Offset="1" Color="#FF1D2227" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodePillBrush" Color="#B51B2329" />
          <SolidColorBrush x:Key="DismodePillBorderBrush" Color="#46535D63" />
          <SolidColorBrush x:Key="DismodeOverlayBrush" Color="#16FFFFFF" />
          <SolidColorBrush x:Key="DismodeSuccessSoftBrush" Color="#283DCB70" />
          <SolidColorBrush x:Key="DismodeOverlayBorderBrush" Color="#33FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="DismodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodeTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="DismodeNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="DismodePanelBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="DismodeCardBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="DismodeMutedTextBrush" Color="#9DA5AA" />
          <!-- Skala tekstu i linii wydzielona z wartosci, ktore juz byly
               rozsypane po MainWindow.xaml jako literalne kolory. -->
          <SolidColorBrush x:Key="DismodePrimaryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="DismodeSecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="DismodeTertiaryTextBrush" Color="#BAC5CACD" />
          <SolidColorBrush x:Key="DismodeSubtleTextBrush" Color="#EF889097" />
          <SolidColorBrush x:Key="DismodeDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="DismodeAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="DismodePurpleBrush" Color="#45CDD8" />
          <SolidColorBrush x:Key="DismodeSuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="DismodeAmberBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="DismodeDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="DismodeTrackBrush" Color="#3345555D" />
          <LinearGradientBrush x:Key="DismodeHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4620D5DB" />
            <GradientStop Offset="0.58" Color="#25157B83" />
            <GradientStop Offset="1" Color="#301D252E" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F205080C" />
            <GradientStop Offset="0.46" Color="#9A05080C" />
            <GradientStop Offset="0.76" Color="#3005080C" />
            <GradientStop Offset="1" Color="#1005080C" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5030EFF4" />
            <GradientStop Offset="1" Color="#2820A9B3" />
          </LinearGradientBrush>
          <!-- Tactical Deck poza menu glownym: te same powierzchnie, krawedz
               lapiaca swiatlo od gory i cyjanowa poswiata po prawej, jak
               w kaflu hero. -->
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F50C1217" />
            <GradientStop Offset="0.52" Color="#F20D141A" />
            <GradientStop Offset="1" Color="#4A1FB9C2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#B300D7E2" />
            <GradientStop Offset="0.22" Color="#FF2A3339" />
            <GradientStop Offset="1" Color="#FF1C2126" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF323C43" />
            <GradientStop Offset="0.4" Color="#FF24292E" />
            <GradientStop Offset="1" Color="#FF1D2227" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodePillBrush" Color="#B51B2329" />
          <SolidColorBrush x:Key="DismodePillBorderBrush" Color="#46535D63" />
          <SolidColorBrush x:Key="DismodeOverlayBrush" Color="#16FFFFFF" />
          <SolidColorBrush x:Key="DismodeSuccessSoftBrush" Color="#283DCB70" />
          <SolidColorBrush x:Key="DismodeOverlayBorderBrush" Color="#33FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="DismodeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F5F8FA" />
            <GradientStop Offset="0.58" Color="#EDF3F5" />
            <GradientStop Offset="1" Color="#E7EEF1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodeTitleBarBrush" Color="#F8FBFC" />
          <SolidColorBrush x:Key="DismodeNavigationBrush" Color="#F7FBFC" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="DismodePanelBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="DismodeCardBorderBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="DismodeMutedTextBrush" Color="#53666E" />
          <SolidColorBrush x:Key="DismodePrimaryTextBrush" Color="#D81A2126" />
          <SolidColorBrush x:Key="DismodeSecondaryTextBrush" Color="#C92B343A" />
          <SolidColorBrush x:Key="DismodeTertiaryTextBrush" Color="#BA3D474D" />
          <SolidColorBrush x:Key="DismodeSubtleTextBrush" Color="#77576C74" />
          <SolidColorBrush x:Key="DismodeDividerBrush" Color="#26576C74" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#53666E" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="#087E86" />
          <SolidColorBrush x:Key="DismodeAccentSoftBrush" Color="#24069AA3" />
          <SolidColorBrush x:Key="DismodePurpleBrush" Color="#126C72" />
          <SolidColorBrush x:Key="DismodeSuccessBrush" Color="#08784D" />
          <SolidColorBrush x:Key="DismodeAmberBrush" Color="#9B5A00" />
          <SolidColorBrush x:Key="DismodeDangerBrush" Color="#B72C38" />
          <SolidColorBrush x:Key="DismodeTrackBrush" Color="#33576C74" />
          <LinearGradientBrush x:Key="DismodeHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#D4EEF1" />
            <GradientStop Offset="0.58" Color="#E6F4F5" />
            <GradientStop Offset="1" Color="#ECF0F2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F4FFFFFF" />
            <GradientStop Offset="0.54" Color="#C6FFFFFF" />
            <GradientStop Offset="1" Color="#20FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4020B2BA" />
            <GradientStop Offset="1" Color="#20158188" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="0.52" Color="#FAF7FBFC" />
            <GradientStop Offset="1" Color="#FFD4EEF1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeDeckHeaderEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#99087E86" />
            <GradientStop Offset="0.22" Color="#40576C74" />
            <GradientStop Offset="1" Color="#33576C74" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="DismodeCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#26576C74" />
            <GradientStop Offset="1" Color="#40576C74" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="DismodePillBrush" Color="#E6EEF3F5" />
          <SolidColorBrush x:Key="DismodePillBorderBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="DismodeOverlayBrush" Color="#0D1A2126" />
          <SolidColorBrush x:Key="DismodeSuccessSoftBrush" Color="#2408784D" />
          <SolidColorBrush x:Key="DismodeOverlayBorderBrush" Color="#26576C74" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="DismodePrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
          <SolidColorBrush x:Key="DismodeDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="DismodeBackgroundBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeTitleBarBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeNavigationBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeCardBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodePanelBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeCardBorderBrush" Color="White" />
          <SolidColorBrush x:Key="DismodeMutedTextBrush" Color="White" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="Black" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="Black" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="White" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="White" />
          <SolidColorBrush x:Key="DismodeAccentBrush" Color="Yellow" />
          <SolidColorBrush x:Key="DismodeAccentSoftBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodePurpleBrush" Color="Yellow" />
          <SolidColorBrush x:Key="DismodeSuccessBrush" Color="Lime" />
          <SolidColorBrush x:Key="DismodeAmberBrush" Color="Yellow" />
          <SolidColorBrush x:Key="DismodeDangerBrush" Color="Red" />
          <SolidColorBrush x:Key="DismodeTrackBrush" Color="White" />
          <SolidColorBrush x:Key="DismodeHeroBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeHeroScrimBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeLogoTileBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeDeckHeaderBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeDeckHeaderEdgeBrush" Color="White" />
          <SolidColorBrush x:Key="DismodeCardEdgeBrush" Color="White" />
          <SolidColorBrush x:Key="DismodePillBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodePillBorderBrush" Color="White" />
          <SolidColorBrush x:Key="DismodeOverlayBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeSuccessSoftBrush" Color="Black" />
          <SolidColorBrush x:Key="DismodeOverlayBorderBrush" Color="White" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style
          x:Key="DismodePageTitleStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <!-- Dlugie polskie tytuly stron zostawaly jednoliniowe i przy
             zwezeniu okna sie ucinaly. -->
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style
          x:Key="DismodeEyebrowStyle"
          TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource DismodeAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
      </Style>

      <Style
          x:Key="DismodeSectionTitleStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodeCardStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource DismodeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
      </Style>

      <Style
          x:Key="DismodePanelStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>

      <Style
          x:Key="DismodeBentoCardStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{ThemeResource DismodeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>

      <!-- Anatomia kart menu glownego dla pozostalych stron: promien 11,
           zwarty odstep 22,17 i krawedz lapiaca swiatlo od gory. -->
      <Style
          x:Key="DismodeDeckCardStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="22,17" />
        <Setter Property="Background" Value="{ThemeResource DismodeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>

      <!-- Naglowek strony skomponowany jak kafel hero: ciemny poklad pod
           tekstem po lewej, poswiata akcentu po prawej, akcentowy naroznik. -->
      <Style
          x:Key="DismodeDeckHeaderStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="24,18" />
        <Setter Property="Background" Value="{ThemeResource DismodeDeckHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeDeckHeaderEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>

      <Style
          x:Key="DismodeStatusPillStyle"
          TargetType="Border">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Background" Value="{ThemeResource DismodePillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodePillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
      </Style>

      <Style
          x:Key="DismodeChipStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{ThemeResource DismodeOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeOverlayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>

      <Style
          x:Key="DismodeBentoTileStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>

      <Style
          x:Key="DismodeMetricValueStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
      </Style>

      <Style
          x:Key="DismodePrimaryButtonStyle"
          TargetType="Button"
          BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Background" Value="{ThemeResource DismodeAccentBrush}" />
        <Setter Property="Foreground" Value="#071018" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeAccentBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodeSecondaryButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodeNavigationItemStyle"
          TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodeTopNavigationStyle"
          TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Padding" Value="16,8,16,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource DismodeMutedTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <Style
          x:Key="DismodeRecoveryButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Foreground" Value="{ThemeResource DismodeAmberBrush}" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeAmberBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodeDangerButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Foreground" Value="{ThemeResource DismodeDangerBrush}" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="DismodePillStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{ThemeResource DismodePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DismodeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
