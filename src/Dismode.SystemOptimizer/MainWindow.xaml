<Window
    x:Class="Dismode.SystemOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="RootLayout"
      Background="{ThemeResource OptimizerBackgroundBrush}"
      RequestedTheme="Dark"
      UseLayoutRounding="True"
      Loaded="RootLayout_Loaded">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border
        x:Name="TitleBarRoot"
        Grid.Row="0"
        Background="{ThemeResource OptimizerTitleBarBrush}"
        BorderBrush="{ThemeResource OptimizerBorderBrush}"
        BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="TitleBarRightInset" Width="138" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Column="1"
            Background="Transparent"
            SizeChanged="TitleBarDragRegion_SizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
              Width="28"
              Height="28"
              Margin="16,0,8,0"
              Background="{ThemeResource OptimizerAccentSoftBrush}"
              BorderBrush="{ThemeResource OptimizerAccentBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <FontIcon
                Glyph="&#xE950;"
                FontSize="14"
                Foreground="{ThemeResource OptimizerAccentBrush}" />
          </Border>
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
            <TextBlock
                Text="Dismode System Optimizer"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="TitleBarVersionText"
                Text="—"
                Style="{StaticResource OptimizerMutedTextStyle}"
                VerticalAlignment="Center" />
          </StackPanel>
          <Border
              Grid.Column="2"
              Margin="16,0"
              Padding="12,4"
              Background="{ThemeResource OptimizerElevatedBrush}"
              BorderBrush="{ThemeResource OptimizerBorderBrush}"
              BorderThickness="1"
              CornerRadius="11">
            <TextBlock
                x:Name="TitleBarModeText"
                Width="102"
                Text="Łączenie…"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                FontSize="12" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <NavigationView
        x:Name="OptimizerNavigation"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        IsPaneOpen="True"
        OpenPaneLength="244"
        CompactPaneLength="52"
        PaneDisplayMode="Auto"
        Background="{ThemeResource OptimizerNavigationBrush}"
        SelectionChanged="OptimizerNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="OverviewNavigationItem" Content="Przegląd" Tag="overview" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Sprzęt i zgodność" Tag="hardware">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Gry i profile" Tag="games">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Testy A/B" Tag="experiments">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Profil globalny" Tag="global">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Laboratorium" Tag="laboratory">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Danger Zone" Tag="danger">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Historia i restore" Tag="history">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ServiceStatusStrip"
            Grid.Row="0"
            Height="64"
            Margin="24,16,24,0"
            Padding="16,0"
            Background="{ThemeResource OptimizerCardBrush}"
            BorderBrush="{ThemeResource DismodeCardEdgeBrush}"
            BorderThickness="1"
            CornerRadius="11">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse
                x:Name="ServiceStatusDot"
                Width="10"
                Height="10"
                Margin="0,0,16,0"
                Fill="{ThemeResource OptimizerWarningBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  x:Name="ServiceStatusTitle"
                  Text="Łączenie z usługą"
                  FontWeight="SemiBold"
                  TextWrapping="NoWrap"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  x:Name="ServiceStatusMessage"
                  Height="18"
                  MaxLines="1"
                  Text="Odczytywanie stanu i ochrony…"
                  Style="{StaticResource OptimizerMutedTextStyle}"
                  TextWrapping="NoWrap"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ProgressRing
                  x:Name="OperationProgressRing"
                  Width="22"
                  Height="22"
                  Visibility="Visible"
                  Opacity="0"
                  IsActive="False"
                  IsHitTestVisible="False" />
              <Button
                  x:Name="RefreshButton"
                  Width="108"
                  Style="{StaticResource OptimizerSecondaryButtonStyle}"
                  AutomationProperties.Name="Odśwież"
                  Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE72C;" FontSize="14" />
                  <TextBlock Text="Odśwież" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,24">
          <ScrollViewer
              x:Name="OverviewPage"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" HorizontalAlignment="Stretch" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="8">
                    <TextBlock Text="DISMODE / SYSTEM OPTIMIZER" Style="{StaticResource OptimizerEyebrowStyle}" />
                    <TextBlock Text="Przegląd" Style="{StaticResource OptimizerPageTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock
                          Text="Bezpieczne poprawki pod gry — każdą zmianę cofniesz jednym kliknięciem."
                          Style="{StaticResource OptimizerMutedTextStyle}"
                          VerticalAlignment="Center" />
                      <ToggleButton
                          Style="{StaticResource OptimizerMoreToggleStyle}"
                          Tag="OverviewProtectionDetails"
                          AutomationProperties.Name="Więcej"
                          Click="ToggleDetails_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="Więcej" />
                          <FontIcon Glyph="&#xE70D;" FontSize="10" />
                        </StackPanel>
                      </ToggleButton>
                    </StackPanel>
                    <TextBlock
                        x:Name="OverviewProtectionDetails"
                        Visibility="Collapsed"
                        Text="Każda akcja przechodzi capability check, snapshot, zapis intencji, apply, niezależny readback i checkpoint. Restore porównuje stan original / applied / current i nie nadpisuje zewnętrznych zmian."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        FontSize="12" />
                  </StackPanel>
                  <Button
                      x:Name="ConsentButton"
                      Grid.Column="1"
                      Width="190"
                      VerticalAlignment="Center"
                      Style="{StaticResource OptimizerPrimaryButtonStyle}"
                      Content="Włącz bezpieczny tryb"
                      Click="ConsentButton_Click" />
                </Grid>
              </Border>

              <Border Style="{StaticResource OptimizerCardStyle}" Background="{ThemeResource OptimizerAccentSoftBrush}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" Background="{ThemeResource OptimizerElevatedBrush}" CornerRadius="11">
                    <FontIcon Glyph="&#xE9D2;" FontSize="24" Foreground="{ThemeResource OptimizerAccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="OverviewStateText" Text="Usługa nie została jeszcze odczytana" Style="{StaticResource OptimizerSectionTitleStyle}" />
                    <TextBlock x:Name="OverviewDetailText" Height="40" MaxLines="2" Text="Dismode niczego nie zmieni bez Twojej zgody i gotowej kopii ustawień." Style="{StaticResource OptimizerMutedTextStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button
                      x:Name="RestoreAllButton"
                      Grid.Column="2"
                      Width="170"
                      VerticalAlignment="Center"
                      Style="{StaticResource OptimizerSecondaryButtonStyle}"
                      Content="Przywróć wszystko"
                      Click="RestoreAllButton_Click" />
                </Grid>
              </Border>

              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OptimizerCardStyle}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="OCHRONA" Style="{StaticResource OptimizerEyebrowStyle}" />
                    <TextBlock x:Name="RecoveryMetricText" Text="Sprawdzanie" Style="{StaticResource OptimizerMetricValueStyle}" />
                    <TextBlock x:Name="RecoveryMetricDetail" Text="Gotowość cofania zmian" Style="{StaticResource OptimizerMutedTextStyle}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OptimizerCardStyle}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="PROFIL GRY" Style="{StaticResource OptimizerEyebrowStyle}" />
                    <TextBlock x:Name="GameProfileMetricText" Text="Brak" Style="{StaticResource OptimizerMetricValueStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Działa tylko podczas grania" Style="{StaticResource OptimizerMutedTextStyle}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OptimizerCardStyle}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="EKSPERYMENT" Style="{StaticResource OptimizerEyebrowStyle}" />
                    <TextBlock x:Name="ExperimentMetricText" Text="Brak" Style="{StaticResource OptimizerMetricValueStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Test płynności A/B w grze" Style="{StaticResource OptimizerMutedTextStyle}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="HardwarePage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="SPRZĘT / ZGODNOŚĆ" Style="{StaticResource OptimizerEyebrowStyle}" />
                  <TextBlock Text="Sprzęt i zgodność" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Wykryte podzespoły dobierają bezpieczne opcje dla Twojego PC."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="HardwarePrivacyDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="HardwarePrivacyDetails"
                      Visibility="Collapsed"
                      Text="Fingerprint nie zawiera numerów seryjnych ani identyfikatorów użytkownika. Służy wyłącznie do wykrycia zmiany sprzętu lub sterownika."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}">
                <Grid RowSpacing="16" ColumnSpacing="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Spacing="4"><TextBlock Text="WINDOWS" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="WindowsBuildText" Text="—" Style="{StaticResource OptimizerMetricValueStyle}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="ARCHITEKTURA" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="ArchitectureText" Text="—" Style="{StaticResource OptimizerMetricValueStyle}" /></StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="CPU" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="CpuText" Text="—" TextWrapping="Wrap" /></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="RAM" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="PhysicalMemoryText" Text="—" /></StackPanel>
                  <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="GPU" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="GraphicsText" Text="—" TextWrapping="Wrap" /></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="SIEĆ" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock x:Name="NetworkText" Text="—" TextWrapping="Wrap" /></StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}">
                <StackPanel Spacing="8"><TextBlock Text="Fingerprint konfiguracji" Style="{StaticResource OptimizerSectionTitleStyle}" /><TextBlock x:Name="FingerprintText" Text="—" FontFamily="Consolas" TextWrapping="Wrap" Style="{StaticResource OptimizerMutedTextStyle}" /></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="GamesPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="PROFILE / SESJA" Style="{StaticResource OptimizerEyebrowStyle}" />
                  <TextBlock Text="Gry i zapisane profile" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Ustawienia przypisane do gry włączają się przy starcie i cofają po zamknięciu."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="GamesScopeDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="GamesScopeDetails"
                      Visibility="Collapsed"
                      Text="Tylko bezpieczne akcje bez restartu mogą być automatycznie przypisane do gry. Profile powstają wyłącznie po pomiarze A/B i są stosowane przez SessionHost do zweryfikowanego procesu gry. Dozwolony zakres automatyczny: AboveNormal dla procesu gry, wyłączenie Power Throttling tylko dla procesu gry, EcoQoS wyłącznie dla zatwierdzonego tła oraz tymczasowy plan zasilania dopiero po wygranym teście."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}">
                <StackPanel Spacing="8"><TextBlock Text="Aktywny profil" Style="{StaticResource OptimizerSectionTitleStyle}" /><TextBlock x:Name="ActiveGameProfileText" Text="Brak aktywnego profilu gry." Style="{StaticResource OptimizerMutedTextStyle}" /></StackPanel>
              </Border>
              <TextBlock Text="Zapisane profile" Style="{StaticResource OptimizerSectionTitleStyle}" />
              <StackPanel x:Name="SavedGameProfilesList" Spacing="16" />
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="ExperimentsPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="BENCHMARK / A/B" Style="{StaticResource OptimizerEyebrowStyle}" />
                  <TextBlock Text="Testy A/B" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Sprawdź w tej samej scenie gry, czy zmiana naprawdę poprawia płynność."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="BenchmarkRulesDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="BenchmarkRulesDetails"
                      Visibility="Collapsed"
                      Text="Jedna funkcja lub grupa na eksperyment. 1. Stabilizacja: 15 sekund po wejściu do tej samej sceny. • 2. Pomiar: 90 sekund, minimum 60 sekund danych i 2000 ramek. • 3. Decyzja: minimum 5% poprawy bez regresji FPS i hitch rate."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}" Background="{ThemeResource OptimizerAccentSoftBrush}">
                <StackPanel Spacing="8"><TextBlock Text="Aktywny eksperyment" Style="{StaticResource OptimizerSectionTitleStyle}" /><TextBlock x:Name="ActiveExperimentText" Text="Brak aktywnego eksperymentu." Style="{StaticResource OptimizerMutedTextStyle}" /></StackPanel>
              </Border>
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OptimizerCardStyle}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Aktywna gra" Style="{StaticResource OptimizerSectionTitleStyle}" />
                    <TextBlock
                        x:Name="ActiveGameLeaseText"
                        Height="40"
                        MaxLines="2"
                        Text="Wykryj aktywną sesję Dismode przed przygotowaniem testu."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="DetectActiveGameButton"
                        Width="180"
                        HorizontalAlignment="Left"
                        Style="{StaticResource OptimizerSecondaryButtonStyle}"
                        Content="Wykryj aktywną grę"
                        Click="DetectActiveGameButton_Click" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OptimizerCardStyle}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Pojedynczy test A/B" Style="{StaticResource OptimizerSectionTitleStyle}" />
                    <ComboBox
                        x:Name="SafeTweakComboBox"
                        MinWidth="260"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Wybierz zmianę do testu"
                        AutomationProperties.Name="Wybierz zmianę do testu"
                        SelectionChanged="SafeTweakComboBox_SelectionChanged" />
                    <TextBlock x:Name="SelectedTweakDescriptionText" Style="{StaticResource OptimizerMutedTextStyle}" />
                    <Button
                        x:Name="PrepareExperimentButton"
                        Width="180"
                        HorizontalAlignment="Left"
                        Style="{StaticResource OptimizerPrimaryButtonStyle}"
                        Content="Przygotuj test A/B"
                        Click="PrepareExperimentButton_Click" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource OptimizerCardStyle}">
                <StackPanel Spacing="16">
                  <TextBlock Text="Przebieg pomiaru" Style="{StaticResource OptimizerSectionTitleStyle}" />
                  <TextBlock
                      x:Name="ExperimentStepText"
                      Height="40"
                      MaxLines="2"
                      Text="Przygotuj eksperyment, a następnie wejdź do powtarzalnej sceny gry."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      TextWrapping="Wrap"
                      TextTrimming="CharacterEllipsis" />
                  <ProgressBar
                      x:Name="ExperimentProgressBar"
                      Height="8"
                      Minimum="0"
                      Maximum="105"
                      Value="0"
                      Opacity="0" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="RunBenchmarkButton"
                        Width="200"
                        Style="{StaticResource OptimizerSecondaryButtonStyle}"
                        Content="Uruchom bieżący wariant"
                        Click="RunBenchmarkButton_Click" />
                    <Button
                        x:Name="KeepResultButton"
                        Width="170"
                        Style="{StaticResource OptimizerSecondaryButtonStyle}"
                        Content="Zapisz dla gry"
                        Click="KeepResultButton_Click" />
                    <Button
                        x:Name="KeepGlobalResultButton"
                        Width="190"
                        Style="{StaticResource OptimizerSecondaryButtonStyle}"
                        Content="Pozostaw globalnie"
                        Click="KeepGlobalResultButton_Click" />
                    <Button
                        x:Name="CancelExperimentButton"
                        Width="150"
                        Style="{StaticResource OptimizerSecondaryButtonStyle}"
                        Content="Anuluj i przywróć"
                        Click="CancelExperimentButton_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border
                  x:Name="BenchmarkResultCard"
                  MinHeight="136"
                  Style="{StaticResource OptimizerCardStyle}">
                <StackPanel Spacing="16">
                  <TextBlock
                      x:Name="BenchmarkVerdictText"
                      Text="Wynik pojawi się po zarejestrowaniu pełnej pary A/B."
                      Style="{StaticResource OptimizerSectionTitleStyle}"
                      TextWrapping="Wrap" />
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock Text="1% LOW" Style="{StaticResource OptimizerEyebrowStyle}" />
                      <TextBlock x:Name="BenchmarkPrimaryMetricText" Text="—" Style="{StaticResource OptimizerMetricValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="ŚREDNI FPS" Style="{StaticResource OptimizerEyebrowStyle}" />
                      <TextBlock x:Name="BenchmarkAverageFpsText" Text="—" Style="{StaticResource OptimizerMetricValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="HITCH RATE" Style="{StaticResource OptimizerEyebrowStyle}" />
                      <TextBlock x:Name="BenchmarkHitchRateText" Text="—" Style="{StaticResource OptimizerMetricValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4">
                      <TextBlock Text="PARY" Style="{StaticResource OptimizerEyebrowStyle}" />
                      <TextBlock x:Name="BenchmarkPairsText" Text="0" Style="{StaticResource OptimizerMetricValueStyle}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="GlobalPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MASZYNA / PROFIL" Style="{StaticResource OptimizerEyebrowStyle}" />
                  <TextBlock Text="Profil globalny" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Stałe ustawienia systemu zatwierdzone po testach."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="GlobalPolicyDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="GlobalPolicyDetails"
                      Visibility="Collapsed"
                      Text="Zmiany restartowe nigdy nie są przełączane przy każdym uruchomieniu gry. Promocja wymaga osobnej akcji „Pozostaw globalnie” po pokazaniu pełnego diffu. Wynik A/B nigdy nie aktywuje profilu samodzielnie."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Stan profilu" Style="{StaticResource OptimizerSectionTitleStyle}" /><TextBlock x:Name="GlobalProfileText" Text="Brak aktywnego profilu globalnego." Style="{StaticResource OptimizerMutedTextStyle}" /><TextBlock x:Name="GlobalProfileDetailsText" Text="Nie zapisano profilu globalnego dla tego użytkownika." TextWrapping="Wrap" Style="{StaticResource OptimizerMutedTextStyle}" /></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="LaboratoryPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="KATALOG / READBACK" Style="{StaticResource OptimizerEyebrowStyle}" />
                  <TextBlock Text="Laboratorium" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Sprawdzone optymalizacje z czytelnym opisem działania i cofania."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="LaboratoryPolicyDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="LaboratoryPolicyDetails"
                      Visibility="Collapsed"
                      Text="Widoczne są wszystkie pozycje katalogu. Brak niezależnej weryfikacji oznacza Unsupported — bez atrapowego Apply."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="LaboratoryCatalogList" Spacing="16">
                <Border Style="{StaticResource OptimizerCardStyle}"><TextBlock Text="Katalog zostanie pobrany z usługi." Style="{StaticResource OptimizerMutedTextStyle}" /></Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="DangerPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <StackPanel Spacing="8">
                  <TextBlock Text="HARD SAFETY POLICY" Style="{StaticResource OptimizerEyebrowStyle}" Foreground="{ThemeResource OptimizerDangerBrush}" />
                  <TextBlock Text="Danger Zone" Style="{StaticResource OptimizerPageTitleStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="Zaawansowane opcje globalne tylko do ręcznych testów A/B."
                        Style="{StaticResource OptimizerMutedTextStyle}"
                        VerticalAlignment="Center" />
                    <ToggleButton
                        Style="{StaticResource OptimizerMoreToggleStyle}"
                        Tag="DangerSafetyDetails"
                        AutomationProperties.Name="Więcej"
                        Click="ToggleDetails_Click">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Więcej" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                  <TextBlock
                      x:Name="DangerSafetyDetails"
                      Visibility="Collapsed"
                      Text="Tych zabezpieczeń Dismode nie wyłącza: Defender, firewall, Windows Update, BitLocker, anti-cheat, Secure Boot, HVCI, mitigacje exploitów, WHEA, watchdog DPC oraz ustawienia BCD pozostają zablokowane. Dostępne są wyłącznie pozycje z realnym snapshotem, stałymi argumentami, niezależnym readbackiem i trójstronnym restore."
                      Style="{StaticResource OptimizerMutedTextStyle}"
                      FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OptimizerCardStyle}" BorderBrush="{ThemeResource OptimizerWarningBrush}">
                <StackPanel Spacing="16">
                  <TextBlock Text="Pojedynczy test globalny" Style="{StaticResource OptimizerSectionTitleStyle}" />
                  <TextBlock Text="Wymaga uruchomionej gry, pełnego pomiaru A/B i przepisania frazy potwierdzającej." Style="{StaticResource OptimizerMutedTextStyle}" />
                  <ComboBox
                      x:Name="DangerousTweakComboBox"
                      MinWidth="300"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Brak wykonywalnej pozycji Dangerous"
                      AutomationProperties.Name="Wybierz ryzykowną pozycję do testu"
                      SelectionChanged="DangerousTweakComboBox_SelectionChanged" />
                  <TextBox
                      x:Name="DangerousConfirmationTextBox"
                      MaxLength="16"
                      Header="Wpisz dokładnie: ROZUMIEM RYZYKO"
                      PlaceholderText="ROZUMIEM RYZYKO"
                      TextChanged="DangerousConfirmationTextBox_TextChanged" />
                  <Button
                      x:Name="PrepareDangerousExperimentButton"
                      Width="230"
                      HorizontalAlignment="Left"
                      Style="{StaticResource OptimizerPrimaryButtonStyle}"
                      Content="Przygotuj pojedynczy test"
                      Click="PrepareDangerousExperimentButton_Click" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="DangerCatalogList" Spacing="16">
                <Border Style="{StaticResource OptimizerCardStyle}"><TextBlock Text="Zablokowane i ryzykowne pozycje zostaną pobrane z usługi." Style="{StaticResource OptimizerMutedTextStyle}" /></Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
              x:Name="HistoryPage"
              Visibility="Collapsed"
              HorizontalScrollMode="Disabled"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1380" Spacing="16">
              <Border Style="{StaticResource DismodeDeckHeaderStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="8"><TextBlock Text="AUDYT / RECOVERY" Style="{StaticResource OptimizerEyebrowStyle}" /><TextBlock Text="Historia i przywracanie" Style="{StaticResource OptimizerPageTitleStyle}" /><TextBlock Text="Zapis wszystkich zmian, testów i przywróceń ustawień." Style="{StaticResource OptimizerMutedTextStyle}" /></StackPanel>
                  <Button Grid.Column="1" Width="170" VerticalAlignment="Center" Style="{StaticResource OptimizerPrimaryButtonStyle}" Content="Przywróć wszystko" Click="RestoreAllButton_Click" />
                </Grid>
              </Border>
              <StackPanel x:Name="HistoryList" Spacing="16">
                <Border Style="{StaticResource OptimizerCardStyle}"><TextBlock Text="Brak zapisanych operacji." Style="{StaticResource OptimizerMutedTextStyle}" /></Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </NavigationView>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="CompactWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="OptimizerNavigation.PaneDisplayMode" Value="LeftCompact" />
            <Setter Target="OptimizerNavigation.IsPaneOpen" Value="False" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="OptimizerNavigation.PaneDisplayMode" Value="Left" />
            <Setter Target="OptimizerNavigation.IsPaneOpen" Value="True" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Window>
