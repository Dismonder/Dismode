<Application
    x:Class="GameShift.SystemOptimizer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="OptimizerBackgroundBrush" Color="#FF070B10" />
          <SolidColorBrush x:Key="OptimizerTitleBarBrush" Color="#FF090D12" />
          <SolidColorBrush x:Key="OptimizerNavigationBrush" Color="#F20B1117" />
          <SolidColorBrush x:Key="OptimizerCardBrush" Color="#F2141C23" />
          <SolidColorBrush x:Key="OptimizerElevatedBrush" Color="#FF1A252D" />
          <SolidColorBrush x:Key="OptimizerBorderBrush" Color="#FF293842" />
          <SolidColorBrush x:Key="OptimizerMutedBrush" Color="#FF91A2AD" />
          <SolidColorBrush x:Key="OptimizerTextBrush" Color="#FFF2F7F9" />
          <SolidColorBrush x:Key="OptimizerAccentBrush" Color="#FF19D3D3" />
          <SolidColorBrush x:Key="OptimizerAccentForegroundBrush" Color="#FF041112" />
          <SolidColorBrush x:Key="OptimizerAccentSoftBrush" Color="#3519D3D3" />
          <SolidColorBrush x:Key="OptimizerSuccessBrush" Color="#FF3BD680" />
          <SolidColorBrush x:Key="OptimizerWarningBrush" Color="#FFFFB84D" />
          <SolidColorBrush x:Key="OptimizerDangerBrush" Color="#FFFF6978" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="OptimizerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerTitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerNavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OptimizerMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
          <SolidColorBrush x:Key="OptimizerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="OptimizerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="OptimizerAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
          <SolidColorBrush x:Key="OptimizerAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="OptimizerSuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
          <SolidColorBrush x:Key="OptimizerWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="OptimizerDangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="OptimizerCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource OptimizerCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OptimizerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="OptimizerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Background" Value="{ThemeResource OptimizerAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizerAccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="OptimizerSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{ThemeResource OptimizerElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OptimizerBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizerTextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="OptimizerPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="OptimizerSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="OptimizerEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource OptimizerAccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
      </Style>
      <Style x:Key="OptimizerMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource OptimizerMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="OptimizerMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
