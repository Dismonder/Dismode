<Application
    x:Class="GameShift.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <LinearGradientBrush x:Key="GameShiftBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GameShiftTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="GameShiftNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="GameShiftCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="GameShiftPanelBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="GameShiftCardBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="GameShiftMutedTextBrush" Color="#9DA5AA" />
          <!-- Skala tekstu i linii wydzielona z wartosci, ktore juz byly
               rozsypane po MainWindow.xaml jako literalne kolory. -->
          <SolidColorBrush x:Key="GameShiftPrimaryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="GameShiftSecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="GameShiftTertiaryTextBrush" Color="#BAC5CACD" />
          <SolidColorBrush x:Key="GameShiftSubtleTextBrush" Color="#77889097" />
          <SolidColorBrush x:Key="GameShiftDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="GameShiftAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="GameShiftAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="GameShiftPurpleBrush" Color="#45CDD8" />
          <SolidColorBrush x:Key="GameShiftSuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="GameShiftAmberBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="GameShiftDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="GameShiftTrackBrush" Color="#3345555D" />
          <LinearGradientBrush x:Key="GameShiftHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4620D5DB" />
            <GradientStop Offset="0.58" Color="#25157B83" />
            <GradientStop Offset="1" Color="#301D252E" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F205080C" />
            <GradientStop Offset="0.46" Color="#9A05080C" />
            <GradientStop Offset="0.76" Color="#3005080C" />
            <GradientStop Offset="1" Color="#1005080C" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5030EFF4" />
            <GradientStop Offset="1" Color="#2820A9B3" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="GameShiftBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF070B0E" />
            <GradientStop Offset="0.62" Color="#FF080C0F" />
            <GradientStop Offset="1" Color="#FF0A0F13" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GameShiftTitleBarBrush" Color="#FF090A0E" />
          <SolidColorBrush x:Key="GameShiftNavigationBrush" Color="#F2090A0E" />
          <SolidColorBrush x:Key="GameShiftCardBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="GameShiftPanelBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="GameShiftCardBorderBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="GameShiftMutedTextBrush" Color="#9DA5AA" />
          <!-- Skala tekstu i linii wydzielona z wartosci, ktore juz byly
               rozsypane po MainWindow.xaml jako literalne kolory. -->
          <SolidColorBrush x:Key="GameShiftPrimaryTextBrush" Color="#D8DDE2E5" />
          <SolidColorBrush x:Key="GameShiftSecondaryTextBrush" Color="#C9D1D8DC" />
          <SolidColorBrush x:Key="GameShiftTertiaryTextBrush" Color="#BAC5CACD" />
          <SolidColorBrush x:Key="GameShiftSubtleTextBrush" Color="#77889097" />
          <SolidColorBrush x:Key="GameShiftDividerBrush" Color="#26394349" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2151A1E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EF1B1F23" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF24292E" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DA5AA" />
          <SolidColorBrush x:Key="GameShiftAccentBrush" Color="#00D7E2" />
          <SolidColorBrush x:Key="GameShiftAccentSoftBrush" Color="#2A00D7E2" />
          <SolidColorBrush x:Key="GameShiftPurpleBrush" Color="#45CDD8" />
          <SolidColorBrush x:Key="GameShiftSuccessBrush" Color="#3DCB70" />
          <SolidColorBrush x:Key="GameShiftAmberBrush" Color="#FFA51F" />
          <SolidColorBrush x:Key="GameShiftDangerBrush" Color="#FF6B73" />
          <SolidColorBrush x:Key="GameShiftTrackBrush" Color="#3345555D" />
          <LinearGradientBrush x:Key="GameShiftHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4620D5DB" />
            <GradientStop Offset="0.58" Color="#25157B83" />
            <GradientStop Offset="1" Color="#301D252E" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F205080C" />
            <GradientStop Offset="0.46" Color="#9A05080C" />
            <GradientStop Offset="0.76" Color="#3005080C" />
            <GradientStop Offset="1" Color="#1005080C" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5030EFF4" />
            <GradientStop Offset="1" Color="#2820A9B3" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="GameShiftBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F5F8FA" />
            <GradientStop Offset="0.58" Color="#EDF3F5" />
            <GradientStop Offset="1" Color="#E7EEF1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GameShiftTitleBarBrush" Color="#F8FBFC" />
          <SolidColorBrush x:Key="GameShiftNavigationBrush" Color="#F7FBFC" />
          <SolidColorBrush x:Key="GameShiftCardBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="GameShiftPanelBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="GameShiftCardBorderBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="GameShiftMutedTextBrush" Color="#53666E" />
          <SolidColorBrush x:Key="GameShiftPrimaryTextBrush" Color="#D81A2126" />
          <SolidColorBrush x:Key="GameShiftSecondaryTextBrush" Color="#C92B343A" />
          <SolidColorBrush x:Key="GameShiftTertiaryTextBrush" Color="#BA3D474D" />
          <SolidColorBrush x:Key="GameShiftSubtleTextBrush" Color="#77576C74" />
          <SolidColorBrush x:Key="GameShiftDividerBrush" Color="#26576C74" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FCFFFFFF" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EAF4F8F9" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33576C74" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#53666E" />
          <SolidColorBrush x:Key="GameShiftAccentBrush" Color="#087E86" />
          <SolidColorBrush x:Key="GameShiftAccentSoftBrush" Color="#24069AA3" />
          <SolidColorBrush x:Key="GameShiftPurpleBrush" Color="#126C72" />
          <SolidColorBrush x:Key="GameShiftSuccessBrush" Color="#08784D" />
          <SolidColorBrush x:Key="GameShiftAmberBrush" Color="#9B5A00" />
          <SolidColorBrush x:Key="GameShiftDangerBrush" Color="#B72C38" />
          <SolidColorBrush x:Key="GameShiftTrackBrush" Color="#33576C74" />
          <LinearGradientBrush x:Key="GameShiftHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#D4EEF1" />
            <GradientStop Offset="0.58" Color="#E6F4F5" />
            <GradientStop Offset="1" Color="#ECF0F2" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#F4FFFFFF" />
            <GradientStop Offset="0.54" Color="#C6FFFFFF" />
            <GradientStop Offset="1" Color="#20FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GameShiftLogoTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#4020B2BA" />
            <GradientStop Offset="1" Color="#20158188" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="GameShiftPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="GameShiftSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="GameShiftTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="GameShiftSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
          <SolidColorBrush x:Key="GameShiftDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="GameShiftBackgroundBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftTitleBarBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftNavigationBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftCardBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftPanelBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftCardBorderBrush" Color="White" />
          <SolidColorBrush x:Key="GameShiftMutedTextBrush" Color="White" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="Black" />
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="Black" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="White" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="White" />
          <SolidColorBrush x:Key="GameShiftAccentBrush" Color="Yellow" />
          <SolidColorBrush x:Key="GameShiftAccentSoftBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftPurpleBrush" Color="Yellow" />
          <SolidColorBrush x:Key="GameShiftSuccessBrush" Color="Lime" />
          <SolidColorBrush x:Key="GameShiftAmberBrush" Color="Yellow" />
          <SolidColorBrush x:Key="GameShiftDangerBrush" Color="Red" />
          <SolidColorBrush x:Key="GameShiftTrackBrush" Color="White" />
          <SolidColorBrush x:Key="GameShiftHeroBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftHeroScrimBrush" Color="Black" />
          <SolidColorBrush x:Key="GameShiftLogoTileBrush" Color="Black" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style
          x:Key="GameShiftPageTitleStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
      </Style>

      <Style
          x:Key="GameShiftEyebrowStyle"
          TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource GameShiftAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
      </Style>

      <Style
          x:Key="GameShiftSectionTitleStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftCardStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource GameShiftCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
      </Style>

      <Style
          x:Key="GameShiftPanelStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>

      <Style
          x:Key="GameShiftBentoCardStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{ThemeResource GameShiftCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>

      <Style
          x:Key="GameShiftBentoTileStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>

      <Style
          x:Key="GameShiftMetricValueStyle"
          TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
      </Style>

      <Style
          x:Key="GameShiftPrimaryButtonStyle"
          TargetType="Button"
          BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Background" Value="{ThemeResource GameShiftAccentBrush}" />
        <Setter Property="Foreground" Value="#071018" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftAccentBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftSecondaryButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftNavigationItemStyle"
          TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftTopNavigationStyle"
          TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Padding" Value="16,8,16,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GameShiftMutedTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <Style
          x:Key="GameShiftRecoveryButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Foreground" Value="{ThemeResource GameShiftAmberBrush}" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftAmberBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftDangerButtonStyle"
          TargetType="Button">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Foreground" Value="{ThemeResource GameShiftDangerBrush}" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style
          x:Key="GameShiftPillStyle"
          TargetType="Border">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{ThemeResource GameShiftPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GameShiftCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
