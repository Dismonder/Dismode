<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameShift.UI.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Układ wzorowany na nakładce RivaTuner: wiersz etykiety i wartości,
    czcionka o stałej szerokości, wartości wyrównane w kolumnie. Stała
    szerokość znaku jest tu funkcją, nie stylistyką — przy zmiennej liczba
    skacze w poziomie przy każdej zmianie i to widać kątem oka w trakcie gry.

    Tło jest półprzezroczyste i ciemne, bez ramki i bez zaokrągleń: nakładka
    ma być czytelna na jasnej i ciemnej scenie, a nie ładna sama w sobie.
  -->
  <Grid x:Name="OverlayRoot" Background="Transparent">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
    </Grid.RenderTransform>

    <Border
        x:Name="OverlaySurfaceBorder"
        Padding="10,6"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#B0000000">
      <StackPanel x:Name="OverlayStatisticsContent" Spacing="1">

        <TextBlock
            x:Name="GameNameText"
            FontFamily="Consolas"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#FF9AA4AC"
            TextTrimming="CharacterEllipsis"
            MaxWidth="220"
            Text="—" />

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
              Grid.Row="0"
              FontFamily="Consolas"
              FontSize="13"
              Foreground="#FF9AA4AC"
              Text="FPS" />
          <TextBlock
              x:Name="FpsValueText"
              Grid.Row="0"
              Grid.Column="1"
              FontFamily="Consolas"
              FontSize="19"
              FontWeight="Bold"
              HorizontalAlignment="Right"
              Foreground="#FF5BE37D"
              Text="—" />

          <TextBlock
              Grid.Row="1"
              FontFamily="Consolas"
              FontSize="13"
              Foreground="#FF9AA4AC"
              Text="1% LOW" />
          <TextBlock
              x:Name="OnePercentLowText"
              Grid.Row="1"
              Grid.Column="1"
              FontFamily="Consolas"
              FontSize="15"
              HorizontalAlignment="Right"
              Foreground="#FFE6ECF0"
              Text="—" />

          <TextBlock
              Grid.Row="2"
              FontFamily="Consolas"
              FontSize="13"
              Foreground="#FF9AA4AC"
              Text="KLATKA" />
          <TextBlock
              x:Name="FrameTimeValueText"
              Grid.Row="2"
              Grid.Column="1"
              FontFamily="Consolas"
              FontSize="15"
              HorizontalAlignment="Right"
              Foreground="#FFE6ECF0"
              Text="—" />
        </Grid>

        <!--
          Wykres czasu klatki. To on pokazuje przycięcia, których średnia
          nie widzi: pojedynczy skok jest tu widoczny od razu, a w liczbie
          FPS ginie w uśrednieniu.
        -->
        <Polyline
            x:Name="FrameGraphLine"
            Height="26"
            Width="150"
            Margin="0,3,0,0"
            Stroke="#FF5BE37D"
            StrokeThickness="1"
            HorizontalAlignment="Left" />

        <TextBlock
            x:Name="SourceStatusText"
            FontFamily="Consolas"
            FontSize="9"
            Foreground="#FF6C7880"
            Text="" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
