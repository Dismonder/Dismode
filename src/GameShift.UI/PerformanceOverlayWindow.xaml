<Window
    x:Class="GameShift.UI.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
      x:Name="OverlayRoot"
      Width="328"
      Height="120"
      Background="Transparent"
      RenderTransformOrigin="0,0">
    <Grid.RenderTransform>
      <ScaleTransform
          x:Name="OverlayScaleTransform"
          ScaleX="1"
          ScaleY="1" />
    </Grid.RenderTransform>

    <Grid
        x:Name="OverlayStatisticsContent"
        Background="Transparent">

    <!-- 1. FULL DETAILS LAYOUT -->
    <Border
        x:Name="OverlaySurfaceBorder"
        Margin="1"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="18">
      <Grid
          x:Name="FullDeckLayout"
          Margin="8,5,8,5"
          Background="Transparent"
          RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="18" />
          <RowDefinition Height="50" />
          <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
              x:Name="GameNameText"
              VerticalAlignment="Center"
              Foreground="#FFF4F8FA"
              FontFamily="Segoe UI Variable Display"
              FontSize="10"
              FontWeight="SemiBold"
              MaxLines="1"
              TextTrimming="CharacterEllipsis" />
          <Border
              x:Name="StatusBadgeBorder"
              Grid.Column="1"
              Padding="4,1"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse
                  x:Name="SourceIndicator"
                  Width="5"
                  Height="5"
                  VerticalAlignment="Center"
                  Fill="#FF3BDC9B" />
              <TextBlock
                  x:Name="StatusBadgeText"
                  Foreground="#FF7EF0C2"
                  FontSize="7"
                  FontWeight="Bold"
                  CharacterSpacing="80"
                  Text="LIVE" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            x:Name="FullDeckPrimaryMetrics"
            Grid.Row="1"
            ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border
              x:Name="FpsPanelBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
              <TextBlock
                  x:Name="FpsValueText"
                  VerticalAlignment="Center"
                  Foreground="#FF35F2D0"
                  FontFamily="Cascadia Mono"
                  FontSize="31"
                  FontWeight="SemiBold"
                  CharacterSpacing="-40"
                  Text="—" />
              <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock
                    Foreground="#FFF4FAF9"
                    FontSize="10"
                    FontWeight="Bold"
                    CharacterSpacing="45"
                    Text="FPS" />
                <TextBlock
                    Foreground="#FF5CBFAE"
                    FontSize="6"
                    CharacterSpacing="70"
                    Text="LIVE" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Rectangle
              Grid.Column="1"
              Width="1"
              Margin="0,8"
              Fill="#4035F2D0" />
          <Border
              x:Name="FrameTimePanelBorder"
              Grid.Column="2"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">
            <Grid VerticalAlignment="Center" RowSpacing="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#FF6F8790"
                    FontSize="7"
                    FontWeight="SemiBold"
                    CharacterSpacing="85"
                    Text="FRAME" />
                <TextBlock
                    x:Name="FrameTimeValueText"
                    Foreground="#FFF2F7F7"
                    FontFamily="Cascadia Mono"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Text="—" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="#FF8A9AA2"
                    FontSize="8"
                    Text="ms" />
              </StackPanel>
              <Border
                  Grid.Row="1"
                  Width="72"
                  Height="2"
                  HorizontalAlignment="Left"
                  Background="#2635F2D0"
                  CornerRadius="1">
                <Border
                    x:Name="FrameTimeIndicatorBar"
                    Width="28"
                    HorizontalAlignment="Left"
                    Background="#FF35F2D0"
                    CornerRadius="1" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid
            x:Name="FullDeckStatusRow"
            Grid.Row="2"
            ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="104" />
          </Grid.ColumnDefinitions>
          <Border
              x:Name="TelemetryStripBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Canvas
                  Width="58"
                  Height="18"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
                <Line
                    X1="0"
                    X2="58"
                    Y1="17"
                    Y2="17"
                    Stroke="#2635F2D0"
                    StrokeThickness="1" />
                <Line
                    X1="0"
                    X2="58"
                    Y1="8"
                    Y2="8"
                    Stroke="#141A7F75"
                    StrokeDashArray="2,4"
                    StrokeThickness="1" />
                <Polyline
                    x:Name="FrameGraphLine"
                    Stroke="#FF35F2D0"
                    StrokeLineJoin="Round"
                    StrokeThickness="1.5" />
              </Canvas>
              <StackPanel
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="0">
                <TextBlock
                    Foreground="#FF5E747E"
                    FontSize="6"
                    FontWeight="SemiBold"
                    CharacterSpacing="80"
                    Text="PRESENTMON / ETW" />
                <TextBlock
                    x:Name="SourceStatusText"
                    Foreground="#FFB4C4C7"
                    FontSize="7"
                    MaxLines="1"
                    Text="Synchronizacja ze źródłem"
                    TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
          <Border
              x:Name="AutoRestoreBadgeBorder"
              Grid.Column="1"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse
                    x:Name="AutoRestoreIndicator"
                    Width="5"
                    Height="5"
                    VerticalAlignment="Center"
                    Fill="#FF3BDC9B" />
                <TextBlock
                    x:Name="AutoRestoreStatusText"
                    Foreground="#FF78EFC2"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="8"
                    FontWeight="Bold"
                    CharacterSpacing="45"
                    Text="UZBROJONE" />
              </StackPanel>
              <TextBlock
                  x:Name="AutoRestoreDetailText"
                  Foreground="#FF667D7B"
                  FontSize="6"
                  MaxLines="1"
                  Text="PO WYJŚCIU Z GRY"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- 2. COMPACT BAR LAYOUT -->
    <Border
        x:Name="CompactBarLayout"
        Margin="1"
        Padding="12,6"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="14"
        Visibility="Collapsed">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock
              x:Name="CompactFpsValueText"
              Foreground="#FF35F2D0"
              FontFamily="Cascadia Mono"
              FontSize="18"
              FontWeight="Bold"
              Text="—" />
          <TextBlock
              Foreground="#FF8A9AA2"
              FontSize="10"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Text="FPS" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock
              x:Name="CompactFrameTimeValueText"
              Foreground="#FFF2F7F7"
              FontFamily="Cascadia Mono"
              FontSize="13"
              FontWeight="SemiBold"
              Text="—" />
          <TextBlock
              Foreground="#FF8A9AA2"
              FontSize="9"
              VerticalAlignment="Center"
              Text="ms" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 3. MINIMAL TEXT ONLY LAYOUT (NO BACKGROUND, NO BORDER) -->
    <Grid
        x:Name="MinimalTextLayout"
        Padding="6,4"
        Background="Transparent"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock
            x:Name="MinimalFpsValueText"
            Foreground="#FF35F2D0"
            FontFamily="Cascadia Mono"
            FontSize="22"
            FontWeight="Bold"
            Text="—" />
        <TextBlock
            Foreground="#FFE0E8EB"
            FontSize="12"
            FontWeight="Bold"
            VerticalAlignment="Center"
            Text="FPS" />
      </StackPanel>
    </Grid>
    </Grid>
  </Grid>
</Window>
