                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    ColumnSpacing="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox
                      x:Name="LibrarySearchBox"
                      MinWidth="320"
                      MaxWidth="420"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Szukaj gry w bibliotece"
                      PlaceholderText="Szukaj gry…"
                      TextChanged="OnLibrarySearchTextChanged"
                      ToolTipService.ToolTip="Filtruje bibliotekę po nazwie gry" />
                  <TextBlock
                      x:Name="LibrarySearchSummary"
                      Grid.Column="1"
                      Margin="14,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource GameShiftMutedTextBrush}"
                      FontSize="13"
                      Text="" />
                </Grid>
              </Grid>
            </Border>

            <Border
                x:Name="LibraryHeroPanel"
                Grid.Row="1"
                Height="208"
                Margin="0,14,0,0"
                BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
              <Grid>
                <Border
                    Width="420"
                    HorizontalAlignment="Right"
                    CornerRadius="0,16,16,0">
                  <Border.Clip>
                    <RectangleGeometry Rect="0,0,420,208" />
                  </Border.Clip>
                  <Image
                      x:Name="LibraryHeroImage"
                      Stretch="UniformToFill" />
                </Border>
                <Border Background="{ThemeResource GameShiftHeroScrimBrush}" />
                <StackPanel
                    MaxWidth="640"
                    Margin="28,0,28,24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Height="23"
                        Padding="9,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource GameShiftAccentSoftBrush}"
                        CornerRadius="6">
                      <TextBlock
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource GameShiftAccentBrush}"
                          FontSize="10.5"
                          FontWeight="SemiBold"
                          Text="OSTATNIO GRANE" />
                    </Border>
                    <Border
                        Height="23"
                        Padding="9,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource GameShiftPanelBrush}"
                        CornerRadius="6">
                      <TextBlock
                          x:Name="LibraryHeroStateText"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource GameShiftMutedTextBrush}"
                          FontSize="10.5"
                          FontWeight="SemiBold"
                          Text="" />
                    </Border>
                  </StackPanel>
                  <TextBlock
                      x:Name="LibraryHeroTitleText"
                      FontSize="36"
                      Style="{StaticResource GameShiftPageTitleStyle}"
                      Text=""
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      x:Name="LibraryHeroMetaText"
                      Foreground="{ThemeResource GameShiftMutedTextBrush}"
                      FontSize="13"
                      Text=""
                      TextTrimming="CharacterEllipsis" />
                  <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="LibraryHeroLaunchButton"
                        Style="{StaticResource GameShiftPrimaryButtonStyle}"
                        AutomationProperties.Name="Uruchom ostatnio graną grę przez GameShift"
                        Click="OnLibraryHeroLaunchClicked">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Uruchom z GameShift" />
                      </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource GameShiftSecondaryButtonStyle}"
                        AutomationProperties.Name="Otwórz plan optymalizacji dla ostatnio granej gry"
                        Click="OnLibraryHeroPlanClicked">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock Text="Dostosuj plan" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <InfoBar
                x:Name="ProfilesInfoBar"
                Grid.Row="2"
                Margin="0,12,0,10"
                IsClosable="True"
                IsOpen="False"
                Title="Biblioteka" />

            <!-- Bento Games Grid with Clean Poster Artwork Display -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
              <ListView
                  x:Name="ProfilesList"
                  AutomationProperties.Name="Lista profili gier"
                  SelectionChanged="OnProfileSelectionChanged"
                  SelectionMode="Single">
                <ListView.Resources>
                  <!-- Karta rysuje wlasne zaznaczenie; domyslne tlo kontenera
                       wystawalo spod niej jasnym paskiem. -->
                  <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.GroupStyle>
                  <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel
                            Margin="0,14,0,8"
                            Orientation="Horizontal"
                            Spacing="11">
                          <TextBlock
                              VerticalAlignment="Bottom"
                              FontSize="15"
                              FontWeight="SemiBold"
                              Text="{Binding Title}" />
                          <TextBlock
                              VerticalAlignment="Bottom"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="12"
                              Text="{Binding CountLabel}" />
                        </StackPanel>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        ItemWidth="280"
                        ItemHeight="398"
                        Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border
                        Width="264"
                        Height="382"
                        Margin="0,0,16,16"
                        Background="{ThemeResource GameShiftCardBrush}"
                        BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="238" />
                          <RowDefinition Height="88" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Poster Artwork Container -->
                        <Border
                            Grid.Row="0"
                            Background="#FF0B1015"
                            CornerRadius="13,13,0,0">
                          <Grid>
                            <!-- Fallback Letter if no artwork -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource GameShiftAccentBrush}"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="54"
                                FontWeight="SemiBold"
                                Opacity="0.3"
                                Visibility="{Binding FallbackInitialVisibility}"
                                Text="{Binding Initial}" />

                            <!-- Crisp Poster Artwork -->
                            <Image
                                x:Name="LibraryPosterImage"
                                Source="{Binding PosterArtworkSource}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <!-- Bottom subtle shadow vignette -->
                            <Rectangle VerticalAlignment="Bottom" Height="50">
                              <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Offset="0" Color="#00000000" />
                                  <GradientStop Offset="1" Color="#D911171C" />
                                </LinearGradientBrush>
                              </Rectangle.Fill>
                            </Rectangle>

                            <!-- Top-Left Launcher Badge -->
                            <Border
                                Margin="8,8,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#D9060A0D"
                                BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,3">
                              <TextBlock
                                  Foreground="{ThemeResource GameShiftAccentBrush}"
                                  FontSize="10"
                                  FontWeight="SemiBold"
                                  Text="{Binding SourceLabel}" />
                            </Border>
                          </Grid>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel
                            x:Name="LibraryGameInfo"
                            Grid.Row="1"
                            Margin="12,8,12,0"
                            Spacing="3">
                          <TextBlock
                              Foreground="White"
                              FontFamily="Segoe UI Variable Display"
                              FontSize="14"
                              FontWeight="SemiBold"
                              MaxLines="2"
                              Text="{Binding DisplayName}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              x:Name="LibraryProfileStateText"
                              Foreground="{ThemeResource GameShiftAccentBrush}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Text="{Binding StateLabel}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="11"
                              Text="{Binding LastPlayedLabel}"
                              TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action Bar -->
                        <Grid
                            Grid.Row="2"
                            Margin="10,0,10,10"
                            ColumnSpacing="6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Button
                              HorizontalAlignment="Stretch"
                              AutomationProperties.HelpText="Uruchamia grę z aktywną optymalizacją GameShift."
                              AutomationProperties.Name="{Binding LaunchAutomationName}"
                              Click="OnLaunchGameFromLibraryClicked"
                              IsEnabled="{Binding IsLaunchEnabled}"
                              Style="{StaticResource GameShiftLibraryCompactButtonStyle}"
                              BorderBrush="{ThemeResource GameShiftAccentBrush}"
                              BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <FontIcon
                                  FontSize="12"
                                  Foreground="{ThemeResource GameShiftAccentBrush}"
                                  Glyph="&#xE768;" />
                              <TextBlock
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Text="Uruchom" />
                            </StackPanel>
                          </Button>

                          <Button
                              Grid.Column="1"
                              Width="36"
                              Padding="0"
                              Style="{StaticResource GameShiftLibraryCompactButtonStyle}"
                              Click="OnOpenGameModeClicked"
                              AutomationProperties.Name="Dostosuj plan optymalizacji dla tej gry"
                              ToolTipService.ToolTip="Dostosuj plan optymalizacji dla tej gry">
                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                          </Button>

                          <Button
                              Grid.Column="2"
                              Width="36"
                              Padding="0"
                              Style="{StaticResource GameShiftLibraryCompactButtonStyle}"
                              AutomationProperties.Name="Zarządzaj OptiScaler dla tej gry"
                              Click="OnManageOptiScalerClicked"
                              ToolTipService.ToolTip="Zainstaluj, zaktualizuj lub usuń OptiScaler">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource GameShiftAccentBrush}"
                                Glyph="&#xE71B;" />
                          </Button>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock
                  x:Name="ProfilesEmptyText"
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="Brak profili. Kliknij 'Wykryj gry' lub 'Dodaj grę EXE'."
                  TextWrapping="Wrap" />
            </Grid>
          </Grid>

          <ScrollViewer
              x:Name="PlanPage"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Visibility="Collapsed">
            <StackPanel
                MaxWidth="1440"
                Margin="24,18,24,36"
                HorizontalAlignment="Stretch"
                Spacing="14">

              <!-- Bento Header Card -->
              <Border
                  Padding="24,18"
                  Background="{ThemeResource GameShiftHeroBrush}"
                  BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
                <Grid x:Name="PlanHeaderGrid" ColumnSpacing="20" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Style="{StaticResource GameShiftEyebrowStyle}"
                        Text="GAMESHIFT / OPTYMALIZACJA SESJI" />
                    <TextBlock
                        Style="{StaticResource GameShiftPageTitleStyle}"
                        Text="Tryb gry i optymalizacja" />
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        Text="Skonfiguruj profil gry, zoptymalizuj aplikacje tła i uruchom sesję z automatycznym przywracaniem."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel x:Name="PlanHeaderBadges" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Border Style="{StaticResource GameShiftPillStyle}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Foreground="{ThemeResource GameShiftSuccessBrush}" FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Auto-Recovery" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GameShiftPillStyle}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Foreground="{ThemeResource GameShiftAccentBrush}" FontSize="12" Glyph="&#xE9D9;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="PresentMon ETW" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>

              <InfoBar
                  x:Name="PlanSafetyInfoBar"
                  IsClosable="True"
                  IsOpen="False"
                  Severity="Informational"
                  Title="Odwracalna optymalizacja" />
              <InfoBar
                  x:Name="PlanInfoBar"
                  IsClosable="True"
                  IsOpen="False"
                  Title="Plan sesji" />

              <!-- Main Bento Grid: 2 Columns -->
              <Grid x:Name="PlanSectionsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="PlanPrimaryColumn" Width="1*" />
                  <ColumnDefinition x:Name="PlanSecondaryColumn" Width="1.15*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left Column: Game & HUD Configuration (Column 0) -->
                <StackPanel Grid.Column="0" Spacing="14">
                  <!-- Game Profile Card -->
                  <Border
                      Padding="20"
                      Background="{ThemeResource GameShiftCardBrush}"
                      BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14">
                    <StackPanel Spacing="12">
                      <TextBlock FontSize="17" FontWeight="SemiBold" Text="1. Profil gry i priorytet" />
                      <ComboBox
                          x:Name="GameProfileSelector"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Gra używana w Trybie gry"
                          DisplayMemberPath="DisplayName"
                          Header="Wybierz grę"
                          PlaceholderText="Wybierz grę z biblioteki"
                          SelectionChanged="OnGameProfileSelectorChanged" />
                      <TextBlock
                          x:Name="PlanLibraryStatusText"
                          Foreground="{ThemeResource GameShiftMutedTextBrush}"
                          FontSize="12"
                          Text="Wyszukiwanie zainstalowanych gier…"
                          TextWrapping="Wrap" />

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="OptimizationIntensitySelector"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Siła optymalizacji procesów tła"
                            Header="Preset optymalizacji"
                            SelectedIndex="0"
                            SelectionChanged="OnOptimizationIntensitySelectionChanged">
                          <ComboBoxItem Content="Zrównoważony" Tag="Standard" />
                          <ComboBoxItem Content="Maksymalna wydajność" Tag="Aggressive" />
                        </ComboBox>
                        <ComboBox
                            x:Name="GamePrioritySelector"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Priorytet procesu gry"
                            Header="Priorytet gry"
                            SelectedIndex="0"
                            SelectionChanged="OnGamePrioritySelectionChanged">
                          <ComboBoxItem Content="Normalny (Zalecany)" Tag="Normal" />
                          <ComboBoxItem Content="Powyżej normalnego" Tag="AboveNormal" />
                          <ComboBoxItem Content="Wysoki" Tag="High" />
                        </ComboBox>
                      </Grid>

                      <InfoBar
                          x:Name="AggressiveModeInfoBar"
                          IsClosable="False"
                          IsOpen="True"
                          Message="Tryb maksymalnej wydajności pozwala na zamykanie aplikacji okienkowych."
                          Severity="Warning"
                          Title="Maksymalna wydajność"
                          Visibility="Collapsed" />

                      <CheckBox
                          x:Name="RememberRulesCheckBox"
                          AutomationProperties.Name="Stosuj i zapamiętuj reguły dla wybranej gry"
                          Content="Zapamiętaj ustawienia dla tej gry"
                          IsChecked="True" />
                    </StackPanel>
                  </Border>

                  <!-- HUD Overlay Card -->
                  <Border
                      Padding="20"
                      Background="{ThemeResource GameShiftCardBrush}"
                      BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14">
                    <StackPanel Spacing="12">
                      <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Nakładka wydajności (HUD)" />
                          <TextBlock
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="12"
                              Text="Wyświetla rzeczywisty FPS i czas generowania klatki w grze."
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                          <ToggleSwitch
                              x:Name="FpsTrackingToggleSwitch"
                              AutomationProperties.Name="Włącz śledzenie FPS"
                              Header="Śledzenie FPS"
                              IsOn="True"
                              OffContent="WYŁ."
                              OnContent="WŁ."
                              Toggled="OnFpsTrackingSettingChanged" />
                          <ToggleSwitch
                              x:Name="FpsOverlayToggleSwitch"
                              AutomationProperties.Name="Włącz nakładkę wydajności w grze"
                              Header="Nakładka FPS"
                              IsOn="True"
                              OffContent="WYŁ."
                              OnContent="WŁ."
                              Toggled="OnFpsOverlaySettingChanged" />
                        </StackPanel>
                      </Grid>

                      <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                          <Grid>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Krycie" />
                            <TextBlock x:Name="OverlayOpacityValueText" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="12" Text="94%" />
                          </Grid>
                          <Slider
                              x:Name="OverlayOpacitySlider"
                              AutomationProperties.Name="Krycie nakładki"
                              LargeChange="10"
                              Maximum="100"
                              Minimum="20"
                              SmallChange="5"
                              SnapsTo="StepValues"
                              StepFrequency="5"
                              Value="94"
                              ValueChanged="OnFpsOverlayValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                          <Grid>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="Skala" />
                            <TextBlock x:Name="OverlaySizeValueText" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="12" Text="100%" />
                          </Grid>
                          <Slider
                              x:Name="OverlaySizeSlider"
                              AutomationProperties.Name="Wielkość nakładki"
                              LargeChange="25"
                              Maximum="150"
                              Minimum="75"
                              SmallChange="5"
                              SnapsTo="StepValues"
                              StepFrequency="5"
                              Value="100"
                              ValueChanged="OnFpsOverlayValueChanged" />
                        </StackPanel>

                        <ComboBox
                            x:Name="OverlayCornerSelector"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Róg ekranu dla nakładki"
                            Header="Pozycja na ekranie"
                            SelectedIndex="1"
                            SelectionChanged="OnFpsOverlayCornerChanged">
                          <ComboBoxItem Content="Lewy górny róg" Tag="TopLeft" />
                          <ComboBoxItem Content="Prawy górny róg" Tag="TopRight" />
                          <ComboBoxItem Content="Lewy dolny róg" Tag="BottomLeft" />
                          <ComboBoxItem Content="Prawy dolny róg" Tag="BottomRight" />
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Right Column: Background Apps & Session Execution (Column 1) -->
                <StackPanel x:Name="PlanSecondarySection" Grid.Column="1" Spacing="14">
                  <!-- Memory & Apps Bento KPI Tiles -->
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="16"
                        Background="{ThemeResource GameShiftCardBrush}"
                        BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                      <StackPanel Spacing="2">
                        <TextBlock Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="12" Text="Wykryte aplikacje" />
                        <TextBlock x:Name="SelectedAppsCountText" FontSize="26" FontWeight="SemiBold" Text="0" />
                      </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource GameShiftCardBrush}"
                        BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                      <StackPanel Spacing="2">
                        <TextBlock Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="12" Text="Szacowany odzysk RAM" />
                        <TextBlock x:Name="SelectedAppsMemoryText" Foreground="{ThemeResource GameShiftSuccessBrush}" FontSize="26" FontWeight="SemiBold" Text="0 MB" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Background Applications List Card -->
                  <Border
                      MinHeight="300"
                      Padding="18"
                      Background="{ThemeResource GameShiftCardBrush}"
                      BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14">
                    <StackPanel Spacing="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="17" FontWeight="SemiBold" Text="2. Aplikacje w tle" />
                          <TextBlock
                              x:Name="ProcessClassificationSummaryText"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="12"
                              Text="Kliknij 'Analizuj aplikacje tła', aby pobrać listę."
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="SmartRecommendationsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnApplySmartRecommendationsClicked"
                            Style="{StaticResource GameShiftSecondaryButtonStyle}"
                            AutomationProperties.Name="Zastosuj inteligentne rekomendacje optymalizacji">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Foreground="{ThemeResource GameShiftAccentBrush}" FontSize="13" Glyph="&#xE9D9;" />
                            <TextBlock Text="Inteligentna selekcja" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <Button
                          x:Name="AnalyzeBackgroundApplicationsButton"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource GameShiftSecondaryButtonStyle}"
                          AutomationProperties.Name="Analizuj aplikacje działające w tle"
                          Click="OnAnalyzeBackgroundApplicationsClicked"
                          IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon FontSize="15" Glyph="&#xE721;" />
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Analizuj aplikacje tła" />
                        </StackPanel>
                      </Button>

                      <Grid MinHeight="120">
                        <ListView
                            x:Name="BackgroundApplicationsList"
                            MaxHeight="260"
                            AutomationProperties.Name="Opcjonalne aplikacje możliwe do ograniczenia lub zamknięcia podczas gry"
                            SelectionMode="None"
                            Visibility="Collapsed">
                          <ListView.ItemTemplate>
                            <DataTemplate>
                              <Border
                                  Margin="0,0,0,8"
                                  Padding="12"
                                  Background="{ThemeResource GameShiftCardBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="14">
                                <Grid ColumnSpacing="12">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <CheckBox
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding DisplayName}"
                                      Checked="OnBackgroundApplicationSelectionChanged"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Unchecked="OnBackgroundApplicationSelectionChanged" />
                                  <StackPanel
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="11"
                                        Text="{Binding ClassificationLabel}"
                                        TextWrapping="Wrap" />
                                  </StackPanel>
                                  <ComboBox
                                      Grid.Column="2"
                                      Margin="0,0,8,0"
                                      MinWidth="150"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Działanie dla procesu"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding IsSelected}"
                                      ItemsSource="{Binding AvailableActions}"
                                      SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                      SelectionChanged="OnBackgroundApplicationSelectionChanged" />
                                  <TextBlock
                                      Grid.Column="3"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold"
                                      Foreground="{ThemeResource GameShiftAccentBrush}"
                                      Text="{Binding MemoryLabel}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="BackgroundApplicationsEmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="0,16">
                          <FontIcon
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource GameShiftAccentBrush}"
                              FontSize="26"
                              Glyph="&#xE9D9;" />
                          <TextBlock
                              x:Name="BackgroundApplicationsEmptyText"
                              MaxWidth="340"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              Text="Kliknij 'Analizuj aplikacje tła', aby zobaczyć aktywne procesy."
                              TextAlignment="Center"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Session Execution Bento Card -->
                  <Border
                      Padding="20"
                      Background="{ThemeResource GameShiftHeroBrush}"
                      BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="14">
                    <StackPanel Spacing="10">
                      <TextBlock
                          x:Name="PlanStateTitleText"
                          FontSize="17"
                          FontWeight="SemiBold"
                          Text="3. Uruchomienie sesji" />
                      <TextBlock
                          x:Name="PlanDetailsText"
                          Foreground="{ThemeResource GameShiftMutedTextBrush}"
                          FontSize="13"
                          Text="Wybierz grę i kliknij przycisk poniżej, aby przygotować i włączyć Tryb gry."
                          TextWrapping="Wrap" />
                      <ListView
                          x:Name="PlanActionsList"
                          MaxHeight="180"
                          AutomationProperties.Name="Lista działań zatwierdzanego planu"
                          SelectionMode="None"
                          Visibility="Collapsed">
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Border
                                Margin="0,0,0,6"
                                Padding="10"
                                Background="{ThemeResource GameShiftCardBrush}"
                                CornerRadius="8">
                              <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Code}" />
                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="PreparePlanButton"
                            Style="{StaticResource GameShiftSecondaryButtonStyle}"
                            AutomationProperties.HelpText="Tworzy plan wybranych ograniczeń i zamknięć."
                            AutomationProperties.Name="Przygotuj plan sesji"
                            Click="OnPreparePlanClicked"
                            Content="Sprawdź plan"
                            IsEnabled="False" />
                        <Button
                            x:Name="StartSessionButton"
                            Style="{StaticResource GameShiftPrimaryButtonStyle}"
                            AutomationProperties.HelpText="Uruchamia grę i aktywuje Tryb gry."
                            AutomationProperties.Name="Zatwierdź plan i włącz Tryb gry"
                            Click="OnStartSessionClicked"
                            Content="WŁĄCZ TRYB GRY"
                            IsEnabled="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RestoreSessionButton"
                            Style="{StaticResource GameShiftRecoveryButtonStyle}"
                            AutomationProperties.HelpText="Przywraca zamknięte aplikacje tła."
                            AutomationProperties.Name="Przywróć aplikacje"
                            Click="OnRestoreSessionClicked"
                            Content="Przywróć aplikacje teraz"
                            IsEnabled="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="CloseGameButton"
                            Style="{StaticResource GameShiftDangerButtonStyle}"
                            AutomationProperties.HelpText="Kończy proces aktywnej gry."
                            AutomationProperties.Name="Zakończ grę"
                            Click="OnCloseGameClicked"
                            Content="Zakończ grę"
                            IsEnabled="False"
                            Visibility="Collapsed" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Hidden elements required for C# bindings -->
                  <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="ServiceClassificationSummaryText" />
                    <ListView
                        x:Name="ServiceClassificationsList"
                        AutomationProperties.Name="Klasyfikacja usług systemowych" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- HISTORY PAGE -->
          <Grid
              x:Name="HistoryPage"
              MaxWidth="1440"
              Margin="24,18,24,30"
              HorizontalAlignment="Stretch"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bento Header -->
            <Border
                Padding="24,18"
                Background="{ThemeResource GameShiftHeroBrush}"
                BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
              <Grid x:Name="HistoryHeaderGrid" ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                  <TextBlock
                      Style="{StaticResource GameShiftEyebrowStyle}"
                      Text="GAMESHIFT / HISTORIA SESJI" />
                  <TextBlock
                      Style="{StaticResource GameShiftPageTitleStyle}"
                      Text="Wyniki i historia sesji" />
                  <TextBlock
                      Foreground="{ThemeResource GameShiftMutedTextBrush}"
                      FontSize="13"
                      Text="Przeglądaj rzeczywiste pomiary FPS, stabilność klatek oraz historię przywracania zasobów."
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="HistoryHeaderAction"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource GameShiftSecondaryButtonStyle}"
                    AutomationProperties.Name="Usuń historię starszą niż 90 dni"
                    Click="OnDeleteOldHistoryClicked">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock Text="Usuń starsze niż 90 dni" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Grid
                x:Name="HistorySummaryPanel"
                Margin="0,14,0,0"
                ColumnSpacing="12"
                Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
                <Border
                    Style="{StaticResource GameShiftBentoCardStyle}"
                    Grid.Column="0">
                  <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="11.5"
                        Text="Sesji w historii" />
                    <TextBlock
                        x:Name="HistorySessionsValueText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="—" />
                  </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource GameShiftBentoCardStyle}"
                    Grid.Column="1">
                  <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="11.5"
                        Text="Łączny czas sesji" />
                    <TextBlock
                        x:Name="HistoryPlaytimeValueText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="—" />
                  </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource GameShiftBentoCardStyle}"
                    Grid.Column="2">
                  <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="11.5"
                        Text="Zastosowanych akcji" />
                    <TextBlock
                        x:Name="HistoryActionsValueText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="—" />
                  </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource GameShiftBentoCardStyle}"
                    Grid.Column="3">
                  <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="11.5"
                        Text="Sesji z problemem" />
                    <TextBlock
                        x:Name="HistoryTroubledValueText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="—" />
                  </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="HistoryInfoBar"
                Grid.Row="1"
                Margin="0,12,0,10"
                IsClosable="True"
                IsOpen="False"
                Title="Historia" />

            <!-- Bento History List -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <ListView
                  x:Name="HistoryList"
                  AutomationProperties.Name="Lista zakończonych sesji"
                  IsItemClickEnabled="False"
                  SelectionMode="None">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border
                        Margin="0,0,0,10"
                        Padding="18,16"
                        Background="{ThemeResource GameShiftCardBrush}"
                        BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                      <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="3*" />
                          <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <!-- Game Icon / Symbol -->
                        <Border
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Background="#1F1ED5DB"
                            BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                          <FontIcon
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource GameShiftAccentBrush}"
                              FontSize="20"
                              Glyph="&#xE7FC;" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                          <Grid x:Name="HistoryIdentityLayout" RowSpacing="4">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="HistoryGameNameText"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{Binding GameDisplayName}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="HistoryStatusText"
                                Grid.Row="1"
                                Foreground="{ThemeResource GameShiftSuccessBrush}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="{Binding StatusLabel}"
                                TextWrapping="Wrap" />
                          </Grid>
                          <TextBlock
                              Foreground="{ThemeResource GameShiftAccentBrush}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Text="{Binding FrameRateSummary}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              x:Name="HistoryActionSummaryText"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="12"
                              Text="{Binding ActionSummary}"
                              TextWrapping="Wrap" />
                          <!-- Hidden Issue summary placeholder -->
                          <TextBlock
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              FontSize="11"
                              Text="{Binding IssueSummary}"
                              Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Spacing="3">
                          <TextBlock
                              x:Name="HistoryEndedAtText"
                              HorizontalAlignment="Right"
                              FontWeight="SemiBold"
                              FontSize="13"
                              Text="{Binding EndedAtLabel}"
                              TextAlignment="Right"
                              TextWrapping="Wrap" />
                          <TextBlock
                              HorizontalAlignment="Right"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="12"
                              Text="{Binding DurationLabel}"
                              TextAlignment="Right"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock
                  x:Name="HistoryEmptyText"
                  Margin="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource GameShiftMutedTextBrush}"
                  FontSize="14"
                  Text="Brak zapisanych sesji. Uruchom grę przez GameShift, aby zmierzyć wydajność."
                  TextWrapping="Wrap" />
            </Grid>
          </Grid>

          <!-- UPDATES PAGE -->
          <ScrollViewer
              x:Name="UpdatesPage"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Visibility="Collapsed">
            <StackPanel
                MaxWidth="1440"
                Margin="24,18,24,40"
                HorizontalAlignment="Stretch"
                Spacing="14">

              <!-- Bento Header -->
              <Border
                  Padding="24,18"
                  Background="{ThemeResource GameShiftHeroBrush}"
                  BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
                <Grid x:Name="UpdatesHeaderGrid" ColumnSpacing="20" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Style="{StaticResource GameShiftEyebrowStyle}"
                        Text="GAMESHIFT / SYSTEM AKTUALIZACJI" />
                    <TextBlock
                        Style="{StaticResource GameShiftPageTitleStyle}"
                        Text="Aktualizacje" />
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        Text="Zapewnij najwyższą kompatybilność z nowymi grami dzięki bezpiecznym aktualizacjom."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                      x:Name="CheckForUpdatesButton"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource GameShiftPrimaryButtonStyle}"
                      Click="OnCheckForUpdatesClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon FontSize="15" Glyph="&#xE72C;" />
                      <TextBlock Text="Sprawdź aktualizacje" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <InfoBar
                  x:Name="UpdateInfoBar"
                  IsClosable="True"
                  IsOpen="False"
                  Title="Aktualizacje" />

              <Grid x:Name="UpdatesSectionsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="UpdatesPrimaryColumn" Width="1.1*" />
                  <ColumnDefinition x:Name="UpdatesSecondaryColumn" Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Current Build Card -->
                <Border
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="10">
                    <TextBlock
                        Style="{StaticResource GameShiftEyebrowStyle}"
                        Text="ZAINSTALOWANA WERSJA" />
                    <TextBlock
                        x:Name="UpdatesCurrentVersionText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="GameShift Gaming Edition" />
                    <TextBlock
                        x:Name="UpdatesStatusText"
                        Foreground="{ThemeResource GameShiftAccentBrush}"
                        FontSize="13"
                        Text="Stan aktualizacji nie został jeszcze sprawdzony."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="UpdatesLastCheckText"
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="12"
                        Text="Ostatnie sprawdzenie: nigdy"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- Update Settings Card -->
                <Border
                    x:Name="UpdatesSettingsCard"
                    Grid.Column="1"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="Ustawienia aktualizacji" />
                    <ToggleSwitch
                        x:Name="AutomaticUpdateChecksToggle"
                        AutomationProperties.Name="Automatycznie sprawdzaj aktualizacje"
                        Header="Sprawdzaj automatycznie w tle"
                        OffContent="Wyłączone"
                        OnContent="Włączone (co 30 dni)"
                        Toggled="OnAutomaticUpdateSettingChanged" />
                    <ToggleSwitch
                        x:Name="AutomaticUpdateInstallToggle"
                        AutomationProperties.Name="Automatycznie pobieraj i instaluj aktualizacje"
                        Header="Automatyczne pobieranie"
                        OffContent="Ręcznie"
                        OnContent="Automatycznie, gdy bezpieczne"
                        Toggled="OnAutomaticUpdateSettingChanged" />
                  </StackPanel>
                </Border>

                <!-- Available Release Card with Visual Pipeline & Animation -->
                <Border
                    x:Name="AvailableUpdateCard"
                    Grid.Row="1"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource GameShiftEyebrowStyle}"
                            Text="DOSTĘPNE WYDANIE" />
                        <TextBlock
                            x:Name="AvailableUpdateVersionText"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="Brak nowej wersji" />
                      </StackPanel>
                      <ProgressRing
                          x:Name="UpdateActivitySpinner"
                          Grid.Column="1"
                          Width="24"
                          Height="24"
                          IsActive="False"
                          Visibility="Collapsed" />
                    </Grid>

                    <!-- Update Pipeline Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border
                          x:Name="UpdateStep1Badge"
                          Background="#2200D7E2"
                          BorderBrush="{ThemeResource GameShiftAccentBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8,4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GameShiftAccentBrush}"
                            Text="1. Manifest" />
                      </Border>
                      <FontIcon Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="10" Glyph="&#xE76C;" />
                      <Border
                          x:Name="UpdateStep2Badge"
                          Background="#16FFFFFF"
                          BorderBrush="#33FFFFFF"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8,4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GameShiftMutedTextBrush}"
                            Text="2. Pobieranie" />
                      </Border>
                      <FontIcon Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="10" Glyph="&#xE76C;" />
                      <Border
                          x:Name="UpdateStep3Badge"
                          Background="#16FFFFFF"
                          BorderBrush="#33FFFFFF"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8,4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GameShiftMutedTextBrush}"
                            Text="3. Weryfikacja SHA-256" />
                      </Border>
                      <FontIcon Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="10" Glyph="&#xE76C;" />
                      <Border
                          x:Name="UpdateStep4Badge"
                          Background="#16FFFFFF"
                          BorderBrush="#33FFFFFF"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="8,4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GameShiftMutedTextBrush}"
                            Text="4. Gotowa" />
                      </Border>
                    </StackPanel>

                    <TextBlock
                        x:Name="UpdateReleaseNotesText"
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        Text="Po sprawdzeniu pojawi się lista zmian i opis wydania."
                        TextWrapping="Wrap" />

                    <!-- Progress and Telemetry -->
                    <StackPanel Spacing="6">
                      <Grid>
                        <TextBlock
                            x:Name="StagedUpdateText"
                            Foreground="{ThemeResource GameShiftAccentBrush}"
                            FontSize="12"
                            FontWeight="Medium"
                            Text="Pakiet nie został pobrany."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="UpdateDownloadPercentText"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource GameShiftAccentBrush}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="0%" />
                      </Grid>

                      <ProgressBar
                          x:Name="UpdateDownloadProgressBar"
                          Height="6"
                          CornerRadius="3"
                          Foreground="{ThemeResource GameShiftAccentBrush}"
                          Background="#22FFFFFF"
                          Maximum="100"
                          Minimum="0"
                          Value="0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                      <Button
                          x:Name="InstallUpdateButton"
                          Style="{StaticResource GameShiftPrimaryButtonStyle}"
                          Click="OnInstallUpdateClicked"
                          IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon FontSize="14" Glyph="&#xE896;" />
                          <TextBlock Text="Zainstaluj aktualizację teraz" />
                        </StackPanel>
                      </Button>
                      <Button
                          x:Name="DownloadUpdateButton"
                          Style="{StaticResource GameShiftSecondaryButtonStyle}"
                          Click="OnDownloadUpdateClicked"
                          Content="Pobierz ponownie"
                          IsEnabled="False" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Trust and Channel Card -->
                <Border
                    x:Name="UpdatesTrustCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="Bezpieczeństwo i prywatność" />
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        Text="Aktualizacje pobierane są wyłącznie z oficjalnego, szyfrowanego serwera i weryfikowane sumami kontrolnymi."
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource GameShiftPillStyle}" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Foreground="{ThemeResource GameShiftSuccessBrush}" FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Oficjalny kanał wydania" />
                      </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="UpdateServiceAddressText"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="11"
                        Text="gameshift-update-service-dev.dismonder.workers.dev"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- DIAGNOSTICS & SETTINGS PAGE -->
          <ScrollViewer
              x:Name="DiagnosticsPage"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Visibility="Collapsed">
            <StackPanel
                MaxWidth="1440"
                Margin="24,18,24,40"
                HorizontalAlignment="Stretch"
                Spacing="14">

              <!-- Bento Header -->
              <Border
                  Padding="24,18"
                  Background="{ThemeResource GameShiftHeroBrush}"
                  BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
                <Grid x:Name="DiagnosticsHeaderGrid" ColumnSpacing="20" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Style="{StaticResource GameShiftEyebrowStyle}"
                        Text="GAMESHIFT / CENTRUM KONDYCJI PC" />
                    <TextBlock
                        Style="{StaticResource GameShiftPageTitleStyle}"
                        Text="Diagnostyka i Ustawienia" />
                    <TextBlock
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        Text="Sprawdź stan optymalizacji Windows, silnika GameShift oraz dostosuj wygląd aplikacji."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel x:Name="DiagnosticsHeaderActions" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button
                        Style="{StaticResource GameShiftSecondaryButtonStyle}"
                        Click="OnRefreshDiagnosticsClicked">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE72C;" />
                        <TextBlock Text="Sprawdź ponownie" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <Grid x:Name="DiagnosticsSectionsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="DiagnosticsPrimaryColumn" Width="1.15*" />
                  <ColumnDefinition x:Name="DiagnosticsSecondaryColumn" Width="0.85*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Gaming & GPU Windows 11 Diagnostics Card -->
                <Border
                    x:Name="DiagnosticsGamingCard"
                    VerticalAlignment="Top"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Foreground="{ThemeResource GameShiftAccentBrush}" FontSize="18" Glyph="&#xE790;" />
                      <TextBlock
                          FontSize="18"
                          FontWeight="SemiBold"
                          Text="Konfiguracja gamingowa Windows &amp; GPU" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DiagnosticsGamingEnvironmentText"
                        Foreground="{ThemeResource GameShiftAccentBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        Text="Badanie konfiguracji..."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DiagnosticsGamingRecommendationsText"
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        Text=""
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- System & Modules Status Card -->
                <Border
                    x:Name="DiagnosticsStatusCard"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Status silnika GameShift" />

                    <Grid RowSpacing="10" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock FontWeight="SemiBold" FontSize="13" Text="Silnik optymalizacji:" />
                      <TextBlock
                          x:Name="DiagnosticsSessionHostText"
                          Grid.Column="1"
                          Foreground="{ThemeResource GameShiftSuccessBrush}"
                          FontSize="13"
                          Text="Gotowy"
                          TextWrapping="Wrap" />

                      <TextBlock Grid.Row="1" FontWeight="SemiBold" FontSize="13" Text="Agent diagnostyczny:" />
                      <TextBlock
                          x:Name="DiagnosticsSystemAgentText"
                          Grid.Row="1"
                          Grid.Column="1"
                          Foreground="{ThemeResource GameShiftSuccessBrush}"
                          FontSize="13"
                          Text="Gotowy"
                          TextWrapping="Wrap" />

                      <TextBlock Grid.Row="2" FontWeight="SemiBold" FontSize="13" Text="System operacyjny:" />
                      <TextBlock
                          x:Name="DiagnosticsPlatformText"
                          Grid.Row="2"
                          Grid.Column="1"
                          FontSize="13"
                          Text="Windows"
                          TextWrapping="Wrap" />
                    </Grid>
                    <!-- Hidden bindings for internal IPC / User SIDs to prevent C# errors -->
                    <StackPanel Visibility="Collapsed">
                      <TextBlock x:Name="DiagnosticsProtocolText" />
                      <TextBlock x:Name="DiagnosticsUserText" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border
                    x:Name="SettingsAppearanceCard"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Wygląd i efekty" />
                    <StackPanel Spacing="8" Margin="0,6,0,0">
                      <TextBlock
                          FontWeight="SemiBold"
                          FontSize="13"
                          Text="Motyw aplikacji" />
                      <ComboBox
                          x:Name="ThemeSelector"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Motyw aplikacji"
                          SelectedIndex="2"
                          SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem Content="Ciemny (Domyślny)" Tag="Dark" />
                        <ComboBoxItem Content="Jasny" Tag="Light" />
                        <ComboBoxItem Content="Zgodny z systemem" Tag="Default" />
                      </ComboBox>
                    </StackPanel>

                    <!-- SFX and VFX Settings -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                      <TextBlock
                          FontWeight="SemiBold"
                          FontSize="13"
                          Text="Efekty gamingowe (SFX / VFX)" />

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock FontSize="13" Text="Dźwięki interfejsu (SFX)" />
                          <TextBlock Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="11" Text="Dźwięki startu sesji, powiadomień i przełączników." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="SfxToggleSwitch"
                            AutomationProperties.Name="Dźwięki interfejsu"
                            Grid.Column="1"
                            IsOn="True"
                            OffContent="WYŁ."
                            OnContent="WŁ."
                            Toggled="OnSfxToggled" />
                      </Grid>

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock FontSize="13" Text="Efekty wizualne (VFX)" />
                          <TextBlock Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="11" Text="Animacje pulsowania, poświaty i przejść Bento." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="VfxToggleSwitch"
                            AutomationProperties.Name="Efekty wizualne"
                            Grid.Column="1"
                            IsOn="True"
                            OffContent="WYŁ."
                            OnContent="WŁ."
                            Toggled="OnVfxToggled" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border
                    x:Name="SettingsPerformanceCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <!-- FPS tracking and overlay can be disabled independently. -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                      <TextBlock
                          FontWeight="SemiBold"
                          FontSize="13"
                          Text="Śledzenie wydajności" />

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontSize="13" Text="Pomiar FPS" />
                          <TextBlock
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="11"
                              Text="Wyłączenie zatrzymuje pomiar i czyści telemetrię sesji."
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="FpsTrackingSettingsToggleSwitch"
                            Grid.Column="1"
                            AutomationProperties.Name="Włącz pomiar FPS w ustawieniach"
                            IsOn="True"
                            OffContent="WYŁ."
                            OnContent="WŁ."
                            Toggled="OnFpsTrackingSettingChanged" />
                      </Grid>

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontSize="13" Text="Nakładka FPS" />
                          <TextBlock
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="11"
                              Text="Wyłączenie ukrywa HUD, ale nie zatrzymuje pomiaru."
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="FpsOverlaySettingsToggleSwitch"
                            Grid.Column="1"
                            AutomationProperties.Name="Włącz nakładkę FPS w ustawieniach"
                            IsOn="True"
                            OffContent="WYŁ."
                            OnContent="WŁ."
                            Toggled="OnFpsOverlaySettingChanged" />
                      </Grid>
                    </StackPanel>

                    <!-- Procesor: co GameShift wykrył i co wolno mu z tym
                         zrobić. Opis stanu jest odczytem z maszyny, nie
                         obietnicą — na jednorodnym procesorze przypinanie do
                         rdzeni nic nie daje i pole to mówi. -->
                    <StackPanel Spacing="10" Margin="0,18,0,0">
                      <TextBlock
                          FontWeight="SemiBold"
                          FontSize="13"
                          Text="Procesor" />

                      <TextBlock
                          x:Name="CpuTopologyText"
                          Foreground="{ThemeResource GameShiftMutedTextBrush}"
                          FontSize="11"
                          Text="Odczytywanie topologii procesora…"
                          TextWrapping="Wrap" />

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock
                              FontSize="13"
                              Text="Ograniczaj procesy tła w trakcie gry" />
                          <TextBlock
                              x:Name="ProBalanceDescriptionText"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="11"
                              Text="Proces w tle, który zaczyna zjadać procesor w trakcie gry, dostaje niższy priorytet i zostaje zamknięty w ćwiartce procesora — resztę GameShift zostawia grze. Zmierzone na 7 Days To Die pod pełnym obciążeniem: p99 czasu klatki 16,80 ms bez tego, 10,65 ms z tym. Wszystko wraca po sesji. Powłoki, anti-cheatu i samej gry GameShift nie dotyka."
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ProBalanceToggleSwitch"
                            Grid.Column="1"
                            AutomationProperties.Name="Ograniczaj procesy tła w trakcie gry"
                            IsOn="False"
                            OffContent="WYŁ."
                            OnContent="WŁ."
                            Toggled="OnProBalanceSettingChanged" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border
                    x:Name="SettingsUpdatesCard"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <StackPanel Spacing="12">
                    <!-- Updates & Version in Settings -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                      <TextBlock
                          FontWeight="SemiBold"
                          FontSize="13"
                          Text="Aktualizacje i Wydania" />

                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock
                              x:Name="SettingsVersionText"
                              FontSize="13"
                              FontWeight="Medium"
                              Text="GameShift Gaming Edition" />
                          <TextBlock
                              x:Name="SettingsUpdatesStatusText"
                              Foreground="{ThemeResource GameShiftMutedTextBrush}"
                              FontSize="11"
                              Text="Wyszukaj najnowsze aktualizacje i pakiety." />
                        </StackPanel>
                        <Button
                            x:Name="CheckForUpdatesInSettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource GameShiftSecondaryButtonStyle}"
                            Click="OnCheckForUpdatesInSettingsClicked">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock FontSize="12" Text="Sprawdź" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border
                    x:Name="MemoryOptimizerCard"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" Background="{ThemeResource GameShiftAccentSoftBrush}" CornerRadius="12">
                      <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GameShiftAccentBrush}" FontSize="22" Glyph="&#xE950;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Memory Optimizer" />
                      <TextBlock x:Name="MemoryOptimizerStatusText" Foreground="{ThemeResource GameShiftAccentBrush}" FontSize="13" FontWeight="SemiBold" Text="Sprawdzanie stanu..." />
                      <TextBlock x:Name="MemoryOptimizerDetailsText" Foreground="{ThemeResource GameShiftMutedTextBrush}" FontSize="12" Text="Opcjonalny komponent GPL działa niezależnie od części gamingowej." TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="OpenMemoryOptimizerButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource GameShiftSecondaryButtonStyle}"
                        Click="OnOpenMemoryOptimizerClicked"
                        Content="Otwórz ustawienia" />
                  </Grid>
                </Border>

                <Border
                    x:Name="SystemOptimizerCard"
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Padding="22"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="46"
                        Height="46"
                        Background="{ThemeResource GameShiftAccentSoftBrush}"
                        CornerRadius="12">
                      <FontIcon
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource GameShiftAccentBrush}"
                          FontSize="22"
                          Glyph="&#xE9D2;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                      <TextBlock
                          FontSize="18"
                          FontWeight="SemiBold"
                          Text="System Optimizer" />
                      <TextBlock
                          x:Name="SystemOptimizerStatusText"
                          Foreground="{ThemeResource GameShiftAccentBrush}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Text="Sprawdzanie stanu..." />
                      <TextBlock
                          x:Name="SystemOptimizerProfileText"
                          Height="18"
                          MaxLines="1"
                          Foreground="{ThemeResource GameShiftMutedTextBrush}"
                          FontSize="12"
                          Text="Brak aktywnego profilu systemowego."
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button
                        x:Name="OpenSystemOptimizerButton"
                        Grid.Column="2"
                        Width="164"
                        VerticalAlignment="Center"
                        Style="{StaticResource GameShiftSecondaryButtonStyle}"
                        Click="OnOpenSystemOptimizerClicked"
                        Content="Otwórz optimizer" />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
    </Grid>
  </Grid>
</Window>
