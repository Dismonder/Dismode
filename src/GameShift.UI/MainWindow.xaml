<Window
    x:Class="GameShift.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameShift">
  <Grid
      x:Name="RootLayout"
      Background="{ThemeResource GameShiftBackgroundBrush}"
      Loaded="OnRootLoaded">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="CompactWindowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ProfilesHeaderActions.(Grid.Row)" Value="1" />
            <Setter Target="ProfilesHeaderActions.(Grid.Column)" Value="0" />
            <Setter Target="ProfilesHeaderActions.Margin" Value="0,12,0,0" />
            <Setter Target="ProfilesHeaderActions.HorizontalAlignment" Value="Left" />
            <Setter Target="UnoptimizedGameActions.(Grid.Row)" Value="1" />
            <Setter Target="UnoptimizedGameActions.(Grid.Column)" Value="1" />
            <Setter Target="UnoptimizedGameActions.Margin" Value="0,8,0,0" />
            <Setter Target="UnoptimizedGameActions.HorizontalAlignment" Value="Left" />
            <Setter Target="PlanHeaderBadges.(Grid.Row)" Value="1" />
            <Setter Target="PlanHeaderBadges.(Grid.Column)" Value="0" />
            <Setter Target="PlanHeaderBadges.Margin" Value="0,12,0,0" />
            <Setter Target="PlanPrimaryColumn.Width" Value="*" />
            <Setter Target="PlanSecondaryColumn.Width" Value="0" />
            <Setter Target="PlanSecondarySection.(Grid.Row)" Value="1" />
            <Setter Target="PlanSecondarySection.(Grid.Column)" Value="0" />
            <Setter Target="HistoryHeaderAction.(Grid.Row)" Value="1" />
            <Setter Target="HistoryHeaderAction.(Grid.Column)" Value="0" />
            <Setter Target="HistoryHeaderAction.Margin" Value="0,12,0,0" />
            <Setter Target="HistoryHeaderAction.HorizontalAlignment" Value="Left" />
            <Setter Target="CheckForUpdatesButton.(Grid.Row)" Value="1" />
            <Setter Target="CheckForUpdatesButton.(Grid.Column)" Value="0" />
            <Setter Target="CheckForUpdatesButton.Margin" Value="0,12,0,0" />
            <Setter Target="CheckForUpdatesButton.HorizontalAlignment" Value="Left" />
            <Setter Target="UpdatesPrimaryColumn.Width" Value="*" />
            <Setter Target="UpdatesSecondaryColumn.Width" Value="0" />
            <Setter Target="UpdatesSettingsCard.(Grid.Row)" Value="1" />
            <Setter Target="UpdatesSettingsCard.(Grid.Column)" Value="0" />
            <Setter Target="AvailableUpdateCard.(Grid.Row)" Value="2" />
            <Setter Target="AvailableUpdateCard.(Grid.Column)" Value="0" />
            <Setter Target="UpdatesTrustCard.(Grid.Row)" Value="3" />
            <Setter Target="UpdatesTrustCard.(Grid.Column)" Value="0" />
            <Setter Target="DiagnosticsHeaderActions.(Grid.Row)" Value="1" />
            <Setter Target="DiagnosticsHeaderActions.(Grid.Column)" Value="0" />
            <Setter Target="DiagnosticsHeaderActions.Margin" Value="0,12,0,0" />
            <Setter Target="DiagnosticsPrimaryColumn.Width" Value="*" />
            <Setter Target="DiagnosticsSecondaryColumn.Width" Value="0" />
            <Setter Target="DiagnosticsStatusCard.(Grid.Row)" Value="1" />
            <Setter Target="DiagnosticsStatusCard.(Grid.Column)" Value="0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ExpandedWindowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1320" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="74" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid
        Padding="30,0,0,0"
        Background="{ThemeResource GameShiftTitleBarBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="138" />
      </Grid.ColumnDefinitions>
      <StackPanel
          Grid.Column="0"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="10">
        <Image
            Width="34"
            Height="34"
            Source="Assets/GameShift.png"
            Stretch="Uniform" />
        <TextBlock
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Display"
            FontSize="22"
            FontWeight="Bold"
            Text="GameShift" />
      </StackPanel>
      <StackPanel
          Grid.Column="1"
          Margin="124,0,20,0"
          HorizontalAlignment="Left"
          Orientation="Horizontal">
        <Button
            x:Name="DashboardNavigationButton"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="dashboard"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Home" />
              <TextBlock Text="Główna" />
            </StackPanel>
            <Border
                x:Name="DashboardNavigationIndicator"
                Width="68"
                Height="3"
                HorizontalAlignment="Center"
                Background="{ThemeResource GameShiftAccentBrush}"
                CornerRadius="2" />
          </StackPanel>
        </Button>
        <Button
            x:Name="ProfilesNavigationButton"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="profiles"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Library" />
              <TextBlock Text="Gry" />
            </StackPanel>
            <Border x:Name="ProfilesNavigationIndicator" Width="68" Height="3" HorizontalAlignment="Center" Background="{ThemeResource GameShiftAccentBrush}" CornerRadius="2" Opacity="0" />
          </StackPanel>
        </Button>
        <Button
            x:Name="PlanNavigationButton"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="plan"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Play" />
              <TextBlock Text="Sesja" />
            </StackPanel>
            <Border x:Name="PlanNavigationIndicator" Width="68" Height="3" HorizontalAlignment="Center" Background="{ThemeResource GameShiftAccentBrush}" CornerRadius="2" Opacity="0" />
          </StackPanel>
        </Button>
        <Button
            x:Name="HistoryNavigationButton"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="history"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Clock" />
              <TextBlock Text="Wyniki" />
            </StackPanel>
            <Border x:Name="HistoryNavigationIndicator" Width="68" Height="3" HorizontalAlignment="Center" Background="{ThemeResource GameShiftAccentBrush}" CornerRadius="2" Opacity="0" />
          </StackPanel>
        </Button>
        <Button
            x:Name="UpdatesNavigationButton"
            Visibility="Collapsed"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="updates"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Download" />
              <TextBlock Text="Aktualizacje" />
            </StackPanel>
            <Border x:Name="UpdatesNavigationIndicator" Width="68" Height="3" HorizontalAlignment="Center" Background="{ThemeResource GameShiftAccentBrush}" CornerRadius="2" Opacity="0" />
          </StackPanel>
        </Button>
        <Button
            x:Name="DiagnosticsNavigationButton"
            Style="{StaticResource GameShiftTopNavigationStyle}"
            Tag="diagnostics"
            Click="OnTopNavigationClicked">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <SymbolIcon Symbol="Setting" />
              <TextBlock Text="Ustawienia" />
            </StackPanel>
            <Border x:Name="DiagnosticsNavigationIndicator" Width="68" Height="3" HorizontalAlignment="Center" Background="{ThemeResource GameShiftAccentBrush}" CornerRadius="2" Opacity="0" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Grid
          x:Name="AppTitleBarDragRegion"
          Grid.Column="2"
          MinWidth="48"
          Margin="8,0"
          Background="Transparent" />
      <StackPanel
          Grid.Column="3"
          Visibility="Collapsed"
          Margin="12,0,16,0"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
        <Ellipse
            Width="7"
            Height="7"
            Fill="{ThemeResource GameShiftSuccessBrush}" />
        <TextBlock
            Foreground="{ThemeResource GameShiftMutedTextBrush}"
            FontSize="12"
            FontWeight="SemiBold"
            Text="SYSTEM GOTOWY" />
      </StackPanel>
      <Border
          Grid.ColumnSpan="5"
          Height="1"
          VerticalAlignment="Bottom"
          Background="{ThemeResource GameShiftCardBorderBrush}" />
    </Grid>
    <Grid Grid.Row="1">
          <ProgressRing
              x:Name="GlobalProgress"
              Width="32"
              Height="32"
              Margin="24"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              AutomationProperties.Name="Trwa odświeżanie danych"
              IsActive="False"
              IsHitTestVisible="False"
              Opacity="0"
              Visibility="Visible"
              Canvas.ZIndex="10" />

          <Grid
              x:Name="DashboardPage"
              Margin="20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="DashboardNotificationRow"
                Canvas.ZIndex="100">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <InfoBar
                  x:Name="DashboardInfoBar"
                  HorizontalAlignment="Stretch"
                  IsClosable="True"
                  IsOpen="False"
                  Severity="Informational"
                  Title="GameShift" />

              <!-- Detected Unoptimized Running Game Banner -->
              <Border
                  x:Name="UnoptimizedGameBanner"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  Padding="16,10"
                  HorizontalAlignment="Stretch"
                  Background="#F00F1710"
                  BorderBrush="{ThemeResource GameShiftSuccessBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Visibility="Collapsed">
                <Grid
                    x:Name="UnoptimizedGameBannerLayout"
                    ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border
                      Width="34"
                      Height="34"
                      Background="#333DCB70"
                      BorderBrush="{ThemeResource GameShiftSuccessBrush}"
                      BorderThickness="1"
                      CornerRadius="7"
                      VerticalAlignment="Center">
                    <FontIcon
                        Foreground="{ThemeResource GameShiftSuccessBrush}"
                        FontSize="16"
                        Glyph="&#xE7E8;" />
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <Grid
                        x:Name="UnoptimizedGameTitleLayout"
                        ColumnSpacing="6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="White"
                          Text="Wykryto aktywną grę:" />
                      <TextBlock
                          x:Name="UnoptimizedGameNameText"
                          Grid.Column="1"
                          FontSize="13"
                          FontWeight="Bold"
                          Foreground="{ThemeResource GameShiftSuccessBrush}"
                          Text="Gra (PID)"
                          TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        x:Name="UnoptimizedGameDetailsText"
                        FontSize="11"
                        Foreground="{ThemeResource GameShiftMutedTextBrush}"
                        Text="Optymalizacje GameShift nie są jeszcze aktywne."
                        TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel
                      x:Name="UnoptimizedGameActions"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="6">
                    <Button
                        x:Name="OptimizeRunningGameButton"
                        Style="{StaticResource GameShiftPrimaryButtonStyle}"
                        Click="OnOptimizeRunningGameClicked">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE7E8;" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Optymalizuj w locie" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <Viewbox
                x:Name="DashboardContentViewbox"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform">
              <Canvas
                  x:Name="DashboardBentoGrid"
                  Width="1444"
                  Height="944">
                <Canvas.ChildrenTransitions>
                  <TransitionCollection>
                    <EntranceThemeTransition
                        FromVerticalOffset="14"
                        IsStaggeringEnabled="True" />
                  </TransitionCollection>
                </Canvas.ChildrenTransitions>

                <!-- Compact game rail spanning the left deck -->
                <Grid
                    Width="157"
                    Height="836"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    RowSpacing="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                  </Grid.RowDefinitions>
                  <ListView
                      x:Name="DashboardGameRail"
                      AutomationProperties.Name="Biblioteka gier"
                      HorizontalContentAlignment="Stretch"
                      SelectionChanged="OnDashboardGameRailSelectionChanged"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="72" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="9" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                              <Grid>
                                <VisualStateManager.VisualStateGroups>
                                  <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                      <VisualState.Setters>
                                        <Setter Target="RailSurface.Opacity" Value="0.88" />
                                      </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                      <VisualState.Setters>
                                        <Setter Target="RailSurface.Opacity" Value="0.72" />
                                      </VisualState.Setters>
                                    </VisualState>
                                  </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="RailSurface"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                  <ContentPresenter
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}" />
                                </Border>
                              </Grid>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Border
                            Height="70"
                            Background="#F20D141A"
                            BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            AutomationProperties.Name="{Binding DisplayName}">
                          <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource GameShiftAccentBrush}"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="30"
                                FontWeight="SemiBold"
                                Visibility="{Binding FallbackInitialVisibility}"
                                Text="{Binding Initial}" />
                            <Image
                                x:Name="DashboardRailPosterImage"
                                Source="{Binding PosterArtworkSource}"
                                Stretch="UniformToFill" />
                            <Border
                                BorderBrush="{ThemeResource GameShiftAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="9"
                                IsHitTestVisible="False"
                                Opacity="{Binding DashboardSelectionOpacity}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <Button
                      Grid.Row="1"
                      Height="30"
                      HorizontalAlignment="Stretch"
                      Padding="0"
                      Background="#D911181E"
                      BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Tag="profiles"
                      Click="OnTopNavigationClicked"
                      AutomationProperties.Name="Otwórz bibliotekę gier"
                      ToolTipService.ToolTip="Otwórz bibliotekę gier">
                    <FontIcon
                        FontSize="15"
                        Glyph="&#xE70D;" />
                  </Button>
                </Grid>

                <!-- Hero: one game, one primary action, real launcher metadata. -->
                <Border
                    x:Name="DashboardHeroCard"
                    Width="1273"
                    Height="359"
                    Canvas.Left="171"
                    Canvas.Top="0"
                    Background="#FF0D141A"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                  <Grid>
                    <Image
                        x:Name="DashboardHeroImage"
                        Source="Assets/TacticalHero.png"
                        Stretch="UniformToFill" />
                    <Rectangle>
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Offset="0" Color="#F9060A0E" />
                          <GradientStop Offset="0.38" Color="#D1060A0E" />
                          <GradientStop Offset="0.68" Color="#52060A0E" />
                          <GradientStop Offset="1" Color="#10060A0E" />
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle VerticalAlignment="Bottom" Height="94">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Offset="0" Color="#00060A0E" />
                          <GradientStop Offset="1" Color="#D6060A0E" />
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel
                        Width="640"
                        Margin="58,48,0,24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Spacing="0">
                      <StackPanel Orientation="Horizontal" Spacing="13">
                        <TextBlock
                            x:Name="DashboardHeroGameText"
                            MaxWidth="480"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="44"
                            FontWeight="SemiBold"
                            CharacterSpacing="-28"
                            MaxLines="1"
                            Text="Wybierz grę"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Margin="0,10,0,0"
                            Padding="10,4"
                            VerticalAlignment="Top"
                            Background="#C4173037"
                            BorderBrush="#7820D5DB"
                            BorderThickness="1"
                            CornerRadius="13">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                Foreground="{ThemeResource GameShiftAccentBrush}"
                                FontSize="12"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Name="DashboardHeroStatusText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource GameShiftAccentBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Wybrana gra" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel Margin="0,18,0,0" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <FontIcon
                              Width="20"
                              Foreground="{ThemeResource GameShiftSecondaryTextBrush}"
                              FontSize="17"
                              Glyph="&#xE7B8;" />
                          <TextBlock
                              x:Name="DashboardHeroSourceText"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource GameShiftPrimaryTextBrush}"
                              FontSize="15"
                              Text="Biblioteka lokalna" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <FontIcon
                              Width="20"
                              Foreground="{ThemeResource GameShiftSecondaryTextBrush}"
                              FontSize="17"
                              Glyph="&#xE823;" />
                          <TextBlock
                              x:Name="DashboardHeroLastPlayedText"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource GameShiftPrimaryTextBrush}"
                              FontSize="15"
                              Text="Ostatnio grano: brak danych" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <FontIcon
                              Width="20"
                              Foreground="{ThemeResource GameShiftSecondaryTextBrush}"
                              FontSize="17"
                              Glyph="&#xE916;" />
                          <TextBlock
                              x:Name="DashboardHeroPlaytimeText"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource GameShiftPrimaryTextBrush}"
                              FontSize="15"
                              Text="Czas gry: brak danych" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Margin="0,25,0,0" Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="DashboardHeroPlayButton"
                            Width="329"
                            Height="58"
                            Padding="18,0"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Graj przez GameShift"
                            BorderBrush="#FF28E9EF"
                            BorderThickness="1"
                            Click="OnLaunchSelectedFromDashboardClicked"
                            CornerRadius="8"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#FF061014">
                          <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Offset="0" Color="#FF29E9EF" />
                              <GradientStop Offset="1" Color="#FF11AAB4" />
                            </LinearGradientBrush>
                          </Button.Background>
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="21" Glyph="&#xE768;" />
                            <TextBlock VerticalAlignment="Center" Text="Graj przez GameShift" />
                          </StackPanel>
                        </Button>
                        <Button
                            Width="56"
                            Height="58"
                            Padding="0"
                            Background="#CC161D23"
                            BorderBrush="#8B9AA4AA"
                            BorderThickness="1"
                            CornerRadius="9"
                            AutomationProperties.Name="Więcej opcji gry"
                            ToolTipService.ToolTip="Więcej opcji gry">
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuFlyoutItem
                                  Click="OnOpenGameModeClicked"
                                  Text="Plan sesji" />
                              <MenuFlyoutItem
                                  Click="OnOpenProfilesClicked"
                                  Text="Biblioteka gier" />
                            </MenuFlyout>
                          </Button.Flyout>
                          <FontIcon FontSize="20" Glyph="&#xE712;" />
                        </Button>
                      </StackPanel>
                      <StackPanel Margin="2,14,0,0" Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource GameShiftAccentBrush}" />
                        <TextBlock
                            Foreground="#B8C5CCD0"
                            FontSize="12"
                            Text="Optymalizacja trwa także po uruchomieniu gry." />
                      </StackPanel>
                      <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="DashboardHeroPathText" />
                        <TextBlock x:Name="DashboardHeroPresetText" />
                        <TextBlock x:Name="DashboardHeroVerifiedText" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Session timeline card. -->
                <Border
                    Width="714"
                    Height="277"
                    Canvas.Left="171"
                    Canvas.Top="372"
                    Padding="18,15"
                    Background="{ThemeResource GameShiftCardBrush}"
                    BorderBrush="{ThemeResource GameShiftCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="58" />
                      <RowDefinition Height="132" />
                      <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border
                          Width="42"
                          Height="42"
                          VerticalAlignment="Top"
                          Background="#2A20D5DB"
                          CornerRadius="8">
                        <FontIcon
                            Foreground="{ThemeResource GameShiftAccentBrush}"
                            FontSize="23"
                            Glyph="&#xE9D9;" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Sesja gry" />
                        <TextBlock
                            Foreground="{ThemeResource GameShiftMutedTextBrush}"
                            FontSize="12"
                            Text="Pełna optymalizacja i automatyczny powrót" />
                      </StackPanel>
                      <Border
                          Grid.Column="2"
                          Height="32"
                          Padding="13,0"
                          VerticalAlignment="Top"
                          Background="#B51B2329"
                          BorderBrush="#46535D63"
                          BorderThickness="1"
                          CornerRadius="16">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Ellipse
                              Width="7"
                              Height="7"
                              VerticalAlignment="Center"
                              Fill="{ThemeResource GameShiftAccentBrush}" />
                          <TextBlock
                              x:Name="ActiveSessionStateText"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Stan aktywnej sesji"
                              FontSize="12"
                              Text="Gotowość" />
                        </StackPanel>
