<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22631.0</SupportedOSPlatformVersion>
    <AssemblyName>Dismode</AssemblyName>
    <RootNamespace>Dismode.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dismode.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dismode.Core\Dismode.Core.csproj" />
  </ItemGroup>

  <!-- Launcher zalezy tylko od Core; start interfejsu z tokenem pulpitu
       bierze jako zrodlo, nie jako referencje do Dismode.Windows. -->
  <ItemGroup>
    <Compile Include="..\Dismode.Windows\Processes\DesktopUserProcessStarter.cs" Link="Processes\DesktopUserProcessStarter.cs" />
    <Compile Include="..\Dismode.Windows\Processes\StartedProcess.cs" Link="Processes\StartedProcess.cs" />
    <Compile Include="..\Dismode.Windows\Processes\WindowsCommandLine.cs" Link="Processes\WindowsCommandLine.cs" />
  </ItemGroup>
</Project>
