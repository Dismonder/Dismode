#include <windows.h>

#define IDI_GAMESHIFT 101
#define GAMESHIFT_STRINGIZE_DETAIL(value) #value
#define GAMESHIFT_STRINGIZE(value) GAMESHIFT_STRINGIZE_DETAIL(value)

#if !defined(GAMESHIFT_VERSION_MAJOR) || \
    !defined(GAMESHIFT_VERSION_MINOR) || \
    !defined(GAMESHIFT_VERSION_PATCH)
#error GameShift version macros must be provided by MSBuild.
#endif

IDI_GAMESHIFT ICON "..\\..\\assets\\branding\\GameShift.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GAMESHIFT_VERSION_MAJOR,GAMESHIFT_VERSION_MINOR,GAMESHIFT_VERSION_PATCH,0
 PRODUCTVERSION GAMESHIFT_VERSION_MAJOR,GAMESHIFT_VERSION_MINOR,GAMESHIFT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GameShift Development\0"
            VALUE "FileDescription", "GameShift Windows 11 Explorer Command\0"
            VALUE "FileVersion", GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_MAJOR) "." GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_MINOR) "." GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_PATCH) ".0\0"
            VALUE "InternalName", "GameShift.ShellExtension.dll\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 GameShift Development\0"
            VALUE "OriginalFilename", "GameShift.ShellExtension.dll\0"
            VALUE "ProductName", "GameShift Gaming Edition\0"
            VALUE "ProductVersion", GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_MAJOR) "." GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_MINOR) "." GAMESHIFT_STRINGIZE(GAMESHIFT_VERSION_PATCH) ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
